{%- liquid
  assign section_pt = section.settings.padding_top
  assign section_pb = section.settings.padding_bottom
  assign card_bg = section.settings.card_background
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} ea-mission-values"
  style="--ea-mv-pt: {{ section_pt }}px; --ea-mv-pb: {{ section_pb }}px; --ea-mv-card-bg: {{ card_bg }};"
>
  <div class="ea-mission-values__inner">

    <div class="ea-mission-values__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ea-mission-values__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="ea-mission-values__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="ea-mission-values__cards">
        {%- for block in section.blocks -%}
          <div class="ea-mission-values__card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="ea-mission-values__card-icon">
                {{- block.settings.image | image_url: width: 128 | image_tag: loading: 'lazy', alt: block.settings.title | default: 'Mission value icon', class: 'ea-mission-values__card-icon-img' -}}
              </div>
            {%- endif -%}
            <div class="ea-mission-values__card-text">
              {%- if block.settings.title != blank -%}
                <p class="ea-mission-values__card-title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="ea-mission-values__card-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div><!-- /.section -->

{% stylesheet %}
/* .section handles horizontal gutters via --page-margin (16px→40px→64px) */
.ea-mission-values {
  padding-block-start: var(--ea-mv-pt, 64px);
  padding-block-end: var(--ea-mv-pb, 80px);
}

.ea-mission-values__inner {
  display: flex;
  flex-direction: column;
  gap: 48px;
  align-items: center;
  width: 100%;
}

/* ── Header ─────────────────────────────────────────────── */
.ea-mission-values__header {
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
  text-align: center;
  max-width: 838px;
  width: 100%;
}

.ea-mission-values__heading {
  font-size: 48px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.96px;
  color: var(--color-foreground-heading);
  margin: 0;
  max-width: 596px;
}

.ea-mission-values__subtext {
  font-size: 16px;
  line-height: 1.4;
  color: var(--color-foreground);
  margin: 0;
  width: 100%;
}

/* ── Cards row (desktop) ─────────────────────────────────── */
.ea-mission-values__cards {
  display: flex;
  flex-direction: row;
  gap: 16px;
  width: 100%;
  align-items: stretch;
}

/* Card: COLUMN on desktop — icon top, text bottom */
.ea-mission-values__card {
  display: flex;
  flex-direction: column;
  gap: 40px;
  flex: 1 0 0;
  min-width: 0;
  padding: 24px;
  background-color: var(--ea-mv-card-bg, #fbf7f5);
  border-radius: 16px;
  align-items: flex-start;
}

.ea-mission-values__card-icon {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
}

.ea-mission-values__card-icon-img {
  width: 64px !important;
  height: 64px !important;
  object-fit: cover;
  display: block;
}

.ea-mission-values__card-text {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

.ea-mission-values__card-title {
  font-size: 24px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.48px;
  color: var(--color-foreground-heading);
  margin: 0;
}

.ea-mission-values__card-desc {
  font-size: 16px;
  line-height: 1.4;
  color: var(--color-foreground-heading);
  margin: 0;
}

/* ── Tablet only: horizontal scroll, full-bleed ─────────── */
@media screen and (min-width: 750px) and (max-width: 989px) {
  /* let cards visually overflow the grid column */
  .ea-mission-values,
  .ea-mission-values__inner {
    overflow: visible;
  }

  .ea-mission-values__cards {
    /* break out of the section's 40px page margins */
    width: calc(100% + 80px);
    margin-inline: -40px;
    padding-inline: 40px;
    overflow-x: auto;
    flex-wrap: nowrap;
    gap: 16px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ea-mission-values__cards::-webkit-scrollbar {
    display: none;
  }

  .ea-mission-values__card {
    flex: 0 0 264px;
    min-width: 264px;
  }
}

/* ── Mobile: vertical stacked cards ─────────────────────── */
@media screen and (max-width: 749px) {
  .ea-mission-values {
    padding-block-start: 48px;
    padding-block-end: 40px;
  }

  .ea-mission-values__inner {
    gap: 0;
    align-items: flex-start;
  }

  .ea-mission-values__header {
    align-items: flex-start;
    text-align: left;
    max-width: 100%;
    padding-block-end: 40px;
    padding-inline: 0;
  }

  .ea-mission-values__heading {
    font-size: 32px;
    letter-spacing: -0.64px;
    max-width: 100%;
  }

  .ea-mission-values__cards {
    flex-direction: column;
    gap: 12px;
  }

  /* Card: ROW on mobile — icon left, text right */
  .ea-mission-values__card {
    flex-direction: row;
    gap: 16px;
    padding: 16px;
    border-radius: 8px;
    align-items: flex-start;
  }

  .ea-mission-values__card-icon {
    width: 48px;
    height: 48px;
  }

  .ea-mission-values__card-icon-img {
    width: 48px !important;
    height: 48px !important;
  }

  .ea-mission-values__card-text {
    gap: 4px;
  }

  .ea-mission-values__card-title {
    font-size: 16px;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .ea-mission-values__card-desc {
    font-size: 14px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Mission & Values",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our mission is simply to WOW you!®"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "This hope is what drives us to deliver delicious and make more moments matter. It's the reason we spend years developing each unique fruit concept, ensure that every piece of produce meets our standards, and have each arrangement crafted with love and attention to detail. Just like our delightful, fresh, and fruity treats and sweets, we believe in putting our mission where our mouth is."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#fbf7f5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Card description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mission & Values"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
