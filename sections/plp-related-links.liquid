{% liquid
  assign related_links = collection.metafields.ediblearrangement.related_links.value
%}

{% if related_links and related_links.size > 0 %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <div
    class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="tw-mx-auto tw-flex tw-w-full tw-max-w-[928px] tw-flex-col tw-gap-4">
      <p class="tw-m-0 tw-text-label tw-font-medium tw-uppercase tw-tracking-[0.12px] tw-text-secondary-500">
        {{ section.settings.heading }}
      </p>

      <div class="tw-flex tw-flex-wrap tw-gap-2">
        {% for link in related_links %}
          {% if link.url.value != blank and link.title.value != blank %}
            <a
              href="{{ link.url.value }}"
              class="tw-flex tw-items-center tw-gap-1 tw-whitespace-nowrap tw-rounded-[24px] tw-border tw-border-solid tw-border-brand-light-grey tw-bg-brand-white tw-px-3 tw-py-1.5 tw-text-body-small tw-font-normal tw-text-brand-black tw-no-underline tw-transition-colors tw-duration-200 hover:tw-border-brand-black md:tw-h-[38px] md:tw-text-body-regular"
            >
              {% if link.icon.value != blank %}
                <span class="tw-flex tw-h-5 tw-w-5 tw-shrink-0 tw-items-center tw-justify-center">
                  {{
                    link.icon.value
                    | image_url: width: 40
                    | image_tag: loading: 'lazy', class: 'tw-w-full tw-h-full tw-object-contain'
                  }}
                </span>
              {% endif %}
              <span class="tw-flex tw-items-center">
                {{ link.title.value }}
              </span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "PLP Related Links",
  "tag": "section",
  "class": "plp-related-links-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Links"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "PLP Related Links",
      "category": "t:categories.collections"
    }
  ]
}
{% endschema %}
