

{% liquid
  assign max_items = section.settings.max_products

  assign icons_position = section.settings.icons_position | default: 'separated-centered'
  assign icons_visibility = section.settings.icons_visibility | default: 'both'
  assign use_corner_icons = false
  if section.settings.layout_type == 'carousel' and section.settings.icons_style != 'none' and icons_position != 'separated-centered'
    assign use_corner_icons = true
  elsif section.settings.carousel_on_mobile and section.settings.icons_style != 'none' and icons_position != 'separated-centered'
    assign use_corner_icons = true
  endif

  assign icons_visibility_class = ''
  if icons_visibility == 'desktop_only'
    assign icons_visibility_class = 'hidden--mobile'
  elsif icons_visibility == 'mobile_only'
    assign icons_visibility_class = 'hidden--desktop'
  endif

%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% assign rl_visible = 0 %}
      {% for product in section.settings.collection.products %}
        {% if rl_visible >= max_items %}{% break %}{% endif %}
        {% unless product.metafields.seo.hidden.value == 1 %}
          {% if rl_visible > 0 %}<!--@list/split-->{% endif %}
          <div
            class="resource-list__item"
          >
            {% # theme-check-disable UniqueStaticBlockId %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
            {% # theme-check-enable UniqueStaticBlockId %}
          </div>
          {% assign rl_visible = rl_visible | plus: 1 %}
        {% endunless %}
      {% endfor %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% if use_corner_icons %}
    <product-list-carousel
      class="product-list__carousel-wrapper force-full-width"
      style="--swipable-arrows-gap: {{ section.settings.icons_gap | default: 24 }}px;"
    >
      {% if icons_position contains 'top' %}
        {% render 'carousel-arrows', position: icons_position, icon: section.settings.icons_style, visibility_class: icons_visibility_class %}
      {% endif %}

      {% render 'resource-list',
        list_items: list_items,
        list_items_array: list_items_array,
        settings: section.settings,
        slide_count: list_items_array.size,
        content_type: 'products',
        test_id: 'resource-list-grid'
      %}

      {% if icons_position contains 'bottom' %}
        {% render 'carousel-arrows', position: icons_position, icon: section.settings.icons_style, visibility_class: icons_visibility_class %}
      {% endif %}
    </product-list-carousel>
  {% else %}
    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      slide_count: list_items_array.size,
      content_type: 'products',
      test_id: 'resource-list-grid'
    %}
  {% endif %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% if use_corner_icons %}
  <script src="{{ 'swipable-group.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}

{% stylesheet %}
  .product-list__carousel-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  product-list-carousel.product-list__carousel-wrapper slideshow-arrows {
    display: none;
  }

  product-list-carousel.product-list__carousel-wrapper .swipable-group__arrows {
    display: flex;
    padding-inline: var(--util-page-margin-offset);
    padding-block: var(--swipable-arrows-gap, 24px) 0;
  }

  product-list-carousel.product-list__carousel-wrapper .swipable-group__arrows--top-right,
  product-list-carousel.product-list__carousel-wrapper .swipable-group__arrows--top-left {
    padding-block: 0 var(--swipable-arrows-gap, 24px);
  }

  product-list-carousel.product-list__carousel-wrapper .swipable-group__arrows--bottom-right,
  product-list-carousel.product-list__carousel-wrapper .swipable-group__arrows--top-right {
    align-self: flex-end;
  }

  product-list-carousel.product-list__carousel-wrapper .swipable-group__arrows--bottom-left,
  product-list-carousel.product-list__carousel-wrapper .swipable-group__arrows--top-left {
    align-self: flex-start;
  }
{% endstylesheet %}

