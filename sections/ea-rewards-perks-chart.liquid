{%- liquid
  assign section_pt = section.settings.padding_top
  assign section_pb = section.settings.padding_bottom
  assign rosette_d = 'M8.77086 0.75C10.2597 0.750153 11.5287 1.72856 12.0189 3.10156C13.3971 2.8755 14.8451 3.55115 15.6009 4.90527C16.3534 6.25348 16.1987 7.87896 15.3304 9C16.1983 10.1213 16.3527 11.7468 15.6 13.0947C14.8442 14.448 13.3973 15.1218 12.0199 14.8965C11.5302 16.2705 10.2604 17.2498 8.77086 17.25C7.28156 17.25 6.01182 16.2711 5.52183 14.8975C4.14402 15.1233 2.69668 14.4492 1.94078 13.0957C1.18808 11.7473 1.34177 10.1202 2.21031 8.99902C1.34282 7.87803 1.1886 6.25305 1.94078 4.90527C2.6965 3.55154 4.14399 2.87598 5.52183 3.10156C6.01203 1.72836 7.28185 0.75 8.77086 0.75ZM8.77086 6.75C7.55992 6.75 6.5775 7.75736 6.5775 9C6.5775 10.2426 7.55992 11.25 8.77086 11.25C9.9816 11.2498 10.9632 10.2425 10.9632 9C10.9632 7.7575 9.9816 6.75023 8.77086 6.75Z'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} ea-perks-chart"
  style="--ea-pc-pt: {{ section_pt }}px; --ea-pc-pb: {{ section_pb }}px;"
>
  <div class="ea-perks-chart__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="ea-perks-chart__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="ea-perks-chart__card">
      <div class="ea-perks-chart__header-row">
        <div class="ea-perks-chart__cell ea-perks-chart__cell--label">Perks</div>
        <div class="ea-perks-chart__cell ea-perks-chart__cell--tier-name ea-perks-chart__cell--tier-1">{{ section.settings.tier_1_name }}</div>
        <div class="ea-perks-chart__cell ea-perks-chart__cell--tier-name ea-perks-chart__cell--tier-2">{{ section.settings.tier_2_name }}</div>
        <div class="ea-perks-chart__cell ea-perks-chart__cell--tier-name ea-perks-chart__cell--tier-3">{{ section.settings.tier_3_name }}</div>
        <div class="ea-perks-chart__cell ea-perks-chart__cell--tier-name ea-perks-chart__cell--tier-4">{{ section.settings.tier_4_name }}</div>
      </div>

      <div class="ea-perks-chart__body">
        {%- for block in section.blocks -%}
          <div class="ea-perks-chart__row{% if forloop.last %} ea-perks-chart__row--last{% endif %}" {{ block.shopify_attributes }}>
            <div class="ea-perks-chart__cell ea-perks-chart__cell--perk-name">{{ block.settings.perk_name }}</div>

            <div class="ea-perks-chart__cell ea-perks-chart__cell--value">
              {%- if block.settings.tier_1_value == 'icon' -%}
                <svg class="ea-perks-chart__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="{{ rosette_d }}" fill="#E10600"/>
                </svg>
              {%- elsif block.settings.tier_1_value != blank -%}
                <span>{{ block.settings.tier_1_value }}</span>
              {%- endif -%}
            </div>

            <div class="ea-perks-chart__cell ea-perks-chart__cell--value">
              {%- if block.settings.tier_2_value == 'icon' -%}
                <svg class="ea-perks-chart__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="{{ rosette_d }}" fill="#C17634"/>
                </svg>
              {%- elsif block.settings.tier_2_value != blank -%}
                <span>{{ block.settings.tier_2_value }}</span>
              {%- endif -%}
            </div>

            <div class="ea-perks-chart__cell ea-perks-chart__cell--value">
              {%- if block.settings.tier_3_value == 'icon' -%}
                <svg class="ea-perks-chart__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="{{ rosette_d }}" fill="#A4A7AC"/>
                </svg>
              {%- elsif block.settings.tier_3_value != blank -%}
                <span>{{ block.settings.tier_3_value }}</span>
              {%- endif -%}
            </div>

            <div class="ea-perks-chart__cell ea-perks-chart__cell--value">
              {%- if block.settings.tier_4_value == 'icon' -%}
                <svg class="ea-perks-chart__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="{{ rosette_d }}" fill="#E1A634"/>
                </svg>
              {%- elsif block.settings.tier_4_value != blank -%}
                <span>{{ block.settings.tier_4_value }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

{% stylesheet %}
.ea-perks-chart {
  padding-block-start: var(--ea-pc-pt, 80px);
  padding-block-end: var(--ea-pc-pb, 80px);
}

.ea-perks-chart__inner {
  display: flex;
  flex-direction: column;
  gap: 32px;
  align-items: center;
  width: 100%;
}

.ea-perks-chart__heading {
  font-size: 48px;
  font-weight: 600;
  line-height: 58px;
  letter-spacing: -0.96px;
  text-align: center;
  color: var(--color-foreground-heading);
  margin: 0;
}

/* ── Card ─────────────────────────────────────────────────── */
.ea-perks-chart__card {
  max-width: 810px;
  width: 100%;
  background: #ffffff;
  border-radius: 4px;
  box-shadow: 0 7px 10px rgba(0, 0, 0, 0.05);
  padding: 24px 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
  color: #000000;
}

/* ── Grid rows (shared) ───────────────────────────────────── */
.ea-perks-chart__header-row,
.ea-perks-chart__row {
  display: grid;
  grid-template-columns: 1.3fr repeat(4, 1fr);
  align-items: center;
  padding-inline: 24px;
}

/* ── Header row ───────────────────────────────────────────── */
.ea-perks-chart__cell--label {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.ea-perks-chart__cell--tier-name {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  text-align: center;
}

.ea-perks-chart__cell--tier-1 { color: #E10600; }
.ea-perks-chart__cell--tier-2 { color: #8E4403; }
.ea-perks-chart__cell--tier-3 { color: #696969; }
.ea-perks-chart__cell--tier-4 { color: #A97000; }

/* ── Body ─────────────────────────────────────────────────── */
.ea-perks-chart__body {
  padding-inline: 24px;
}

.ea-perks-chart__row {
  padding-block: 12px;
  padding-inline: 0;
  border-bottom: 1px solid #E9E9E9;
}

.ea-perks-chart__row--last {
  border-bottom: none;
}

.ea-perks-chart__cell--perk-name {
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
}

.ea-perks-chart__cell--value {
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Rosette icon ─────────────────────────────────────────── */
.ea-perks-chart__icon {
  width: 18px;
  height: 18px;
  display: block;
  flex-shrink: 0;
}

/* ── Mobile ───────────────────────────────────────────────── */
@media screen and (max-width: 749px) {
  .ea-perks-chart {
    padding-block-start: 48px;
    padding-block-end: 48px;
  }

  .ea-perks-chart__heading {
    font-size: 32px;
    line-height: 38px;
    letter-spacing: -0.64px;
  }

  .ea-perks-chart__card {
    padding: 8px 0;
    gap: 9px;
  }

  .ea-perks-chart__header-row {
    padding-inline: 4px 0;
  }

  .ea-perks-chart__cell--label {
    font-size: 12px;
    line-height: 18px;
    padding-inline-start: 5px;
  }

  .ea-perks-chart__cell--tier-name {
    font-size: 12px;
    line-height: 18px;
  }

  .ea-perks-chart__body {
    padding-inline: 8px;
  }

  .ea-perks-chart__row {
    padding-block: 8px;
  }

  .ea-perks-chart__cell--perk-name {
    font-size: 12px;
    line-height: 17px;
  }

  .ea-perks-chart__cell--value {
    font-size: 12px;
    line-height: 17px;
  }
}
{% endstylesheet %}

