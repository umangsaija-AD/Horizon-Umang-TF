<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    collection-tabs-section
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
  data-testid="collection-tabs"
>
  <collection-tabs-component
    data-tab-preset="{{ section.settings.tab_type_preset }}"
    {% if section.settings.tab_active_color != blank %}
      data-tab-active-color="{{ section.settings.tab_active_color }}"
    {% endif %}
    {% if section.settings.tab_inactive_color != blank %}
      data-tab-inactive-color="{{ section.settings.tab_inactive_color }}"
    {% endif %}
    {% if section.settings.tab_font_size != blank %}
      data-tab-font-size="{{ section.settings.tab_font_size }}"
    {% endif %}
  >
    {% content_for 'blocks' %}
  </collection-tabs-component>
</div>

{% stylesheet %}
  .collection-tabs-section {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .collection-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }

  @media (max-width: 749px) {
    .collection-tabs-section {
      --padding-inline-start: 0px;
      --padding-inline-end: 0px;
      padding-inline: 0;
    }

    .collection-tabs__nav {
      justify-content: flex-start;
      column-gap: 1rem;
      row-gap: 0.25rem;
      padding: 0 1rem;
    }
  }

  collection-tabs-component {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .collection-tabs__tab {
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .collection-tabs__tab[aria-selected='true'] {
    text-decoration: underline;
  }

  .collection-tabs__tab:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  collection-tabs-component:not([data-initialized]) .collection-tab-panel ~ .collection-tab-panel {
    display: none;
  }

  .collection-tab-panel[inert] {
    display: none;
  }

  @media (min-width: 750px) {
    .section--page-width.collection-tabs-section collection-tabs-component {
      grid-column: 1 / -1;
    }

    .section--page-width.collection-tabs-section .collection-tabs__nav {
      max-width: var(--full-page-grid-central-column-width);
      margin-inline: auto;
      width: 100%;
    }
  }
{% endstylesheet %}

