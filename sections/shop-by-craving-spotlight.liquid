          "type": "select",
          "id": "thumb_label_preset",
          "label": "Thumbnail label style",
          "options": [
            { "value": "display", "label": "Display" },
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" },
            { "value": "body-regular", "label": "Body regular" },
