        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop by Craving Spotlight",
      "blocks": [
        {
          "type": "craving-category",
          "settings": {
            "label": "Chocolate",
            "tagline": "Rich, velvety chocolate treats.",
            "cta_label": "Shop Chocolate"
          }
