
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    color-{{ section.settings.color_scheme }}
    blog-popular-sidebar
    spacing-style
  "
  data-testid="blog-popular-sidebar"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="blog-popular-sidebar__inner">

    {%- comment -%} ── Column 1: Popular Posts ── {%- endcomment -%}
    <div class="blog-popular-sidebar__col">
      <h2 class="blog-popular-sidebar__heading">{{ section.settings.posts_heading }}</h2>

      <ul class="blog-popular-posts" role="list">
        {%- assign popular_shown = 0 -%}
        {%- for article in blog.articles -%}
          {%- if article.tags contains 'popular' and popular_shown < section.settings.popular_posts_limit -%}
            {%- assign popular_shown = popular_shown | plus: 1 -%}
          <li class="blog-popular-post">
            {%- if article.image -%}
              <a href="{{ article.url }}" class="blog-popular-post__img-link" tabindex="-1" aria-hidden="true">
                <img
                  src="{{ article.image | image_url: width: 160 }}"
                  srcset="
                    {{ article.image | image_url: width: 80 }} 80w,
                    {{ article.image | image_url: width: 160 }} 160w
                  "
                  sizes="80px"
                  width="80"
                  height="80"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                  class="blog-popular-post__img"
                >
              </a>
            {%- else -%}
              <div class="blog-popular-post__img-placeholder"></div>
            {%- endif -%}

            <div class="blog-popular-post__info">
              <a href="{{ article.url }}" class="blog-popular-post__title">
                {{- article.title -}}
              </a>
              <time
                class="blog-popular-post__date"
                datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
              >
                {{- article.published_at | date: '%b %d, %Y' -}}
              </time>
            </div>
          </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%} ── Column 2: Popular Categories ── {%- endcomment -%}
    <div class="blog-popular-sidebar__col">
      <h2 class="blog-popular-sidebar__heading">{{ section.settings.categories_heading }}</h2>

      {%- if section.blocks.size > 0 -%}
        <ul class="blog-popular-categories" role="list">
          {%- for block in section.blocks -%}
            {%- assign cat = block.settings.blog -%}
            {%- if cat != blank -%}
              <li class="blog-popular-category" {{ block.shopify_attributes }}>
                <a href="{{ cat.url }}" class="blog-popular-category__name">
                  {{- cat.title -}}
                </a>
                <span class="blog-popular-category__count">{{ cat.articles_count }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .blog-popular-sidebar {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    border-top: 1px solid var(--color-border);
  }

  .blog-popular-sidebar__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media screen and (max-width: 749px) {
    .blog-popular-sidebar__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* ── Section heading ── */
  .blog-popular-sidebar__heading {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-foreground-heading);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    margin: 0 0 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .blog-popular-sidebar__heading {
      font-size: 24px;
    }
  }

  /* ── Popular Posts ── */
  .blog-popular-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .blog-popular-post {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .blog-popular-post__img-link {
    flex-shrink: 0;
  }

  .blog-popular-post__img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .blog-popular-post__img-placeholder {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 8px;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .blog-popular-post__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.2rem;
  }

  .blog-popular-post__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-foreground-heading);
    text-decoration: none;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 200px;
  }

  .blog-popular-post__title:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .blog-popular-post__title {
      font-size: 15px;
    }
  }

  .blog-popular-post__date {
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    font-weight: 400;
  }

  /* ── Popular Categories ── */
  .blog-popular-categories {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .blog-popular-category {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
  }

  .blog-popular-category:first-child {
    padding-top: 0;
  }

  .blog-popular-category__name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .blog-popular-category__name:hover {
    color: var(--color-foreground-heading);
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .blog-popular-category__name {
      font-size: 15px;
    }
  }

  .blog-popular-category__count {
    font-size: 13px;
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb) / 0.45);
    min-width: 2rem;
    text-align: right;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Popular Sidebar",
  "blocks": [
    {
      "type": "blog_category",
      "name": "Blog Category",
      "settings": [
        {
          "type": "blog",
          "id": "blog",
          "label": "Blog"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "posts_heading",
      "label": "Popular Posts heading",
      "default": "Popular Posts"
    },
    {
      "type": "range",
      "id": "popular_posts_limit",
      "label": "Number of popular posts",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "categories_heading",
      "label": "Popular Categories heading",
      "default": "Popular Categories"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "enabled_on": {
    "templates": ["blog", "article"]
  }
}
{% endschema %}
