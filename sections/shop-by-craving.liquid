{%- liquid
  assign block_count = section.blocks | size
-%}

<shop-by-craving
  id="ShopByCraving-{{ section.id }}"
  class="shop-by-craving color-{{ section.settings.color_scheme }} spacing-style"
  data-auto-interval="{{ section.settings.auto_rotation_interval }}"
  {% render 'spacing-style', settings: section.settings %}
>
  {%- if section.settings.heading != blank -%}
    <div class="shop-by-craving__header">
      <h2 class="shop-by-craving__heading tw-text-h2 tw-text-center">
        {{- section.settings.heading | escape -}}
      </h2>
    </div>
  {%- endif -%}

  <div class="shop-by-craving__panels">
    {%- for block in section.blocks -%}
      {%- if block.type == 'craving-item' -%}
        {%- assign panel_alt = block.settings.category_name | default: 'Category image' -%}
        <div
          class="shop-by-craving__panel"
          data-craving-panel
          data-open="false"
          {{ block.shopify_attributes }}
        >
          {%- comment -%} Background image {%- endcomment -%}
          <div class="shop-by-craving__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'shop-by-craving__image',
                  alt: panel_alt,
                  widths: '375,600,800,1200',
                  sizes: '(min-width: 750px) 33vw, 100vw'
              }}
            {%- else -%}
              <div class="shop-by-craving__image-placeholder"></div>
            {%- endif -%}
          </div>

          {%- comment -%} Dark overlay for text legibility {%- endcomment -%}
          <div class="shop-by-craving__overlay" aria-hidden="true"></div>

          {%- comment -%} Trigger button — always visible {%- endcomment -%}
          <button
            class="shop-by-craving__trigger"
            data-craving-trigger
            aria-expanded="false"
            type="button"
          >
            <span
              class="shop-by-craving__category-name tw-text-{{ block.settings.label_type_preset }}"
              {%- unless block.settings.label_color == blank -%}
                style="color: {{ block.settings.label_color }};"
              {%- endunless -%}
            >
              {{- block.settings.category_name | default: 'Category' | escape -}}
            </span>
          </button>

          {%- comment -%} Revealed content — tagline + CTA {%- endcomment -%}
          <div
            class="shop-by-craving__content"
            aria-hidden="true"
          >
            {%- if block.settings.tagline != blank -%}
              <p
                class="shop-by-craving__tagline tw-text-{{ block.settings.tagline_type_preset }}"
                {%- unless block.settings.tagline_color == blank -%}
                  style="color: {{ block.settings.tagline_color }};"
                {%- endunless -%}
              >
                {{- block.settings.tagline | escape -}}
              </p>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <a
                class="shop-by-craving__cta button"
                href="{{ block.settings.cta_url | default: '#' }}"
              >
                {{- block.settings.cta_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</shop-by-craving>

<script src="{{ 'shop-by-craving.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
/* ============================================================
   Shop by Craving — section styles
   Mobile: panels stack vertically, tap to expand.
   Desktop (≥750px): panels are narrow slivers; hover expands
   the active one to fill all remaining space. The trigger
   button covers the full tile so the entire tile is the hit zone.
   ============================================================ */

.shop-by-craving {
  display: flex;
  flex-direction: column;
}

/* ---- Section heading ---- */
.shop-by-craving__header {
  padding-block-end: 24px;
  width: 100%;
}

.shop-by-craving__heading {
  color: var(--color-foreground);
}

/* ---- Panels container ---- */
.shop-by-craving__panels {
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  gap: 8px;
}

/* ---- Individual panel ---- */
.shop-by-craving__panel {
  position: relative;
  overflow: hidden;
  max-height: 64px;
  transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.shop-by-craving__panel[data-open="true"] {
  max-height: 320px;
}

/* ---- Background media — blur-to-focus effect ---- */
.shop-by-craving__media {
  position: absolute;
  inset: 0;
  z-index: 0;
  /* Collapsed: blurred and desaturated */
  filter: blur(2px) saturate(0.7);
  transition: filter 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.shop-by-craving__panel[data-open="true"] .shop-by-craving__media {
  /* Active: sharp, full colour */
  filter: blur(0) saturate(1);
}

.shop-by-craving__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transform: scale(1);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.shop-by-craving__panel[data-open="true"] .shop-by-craving__image {
  transform: scale(1.03);
}

.shop-by-craving__image-placeholder {
  width: 100%;
  height: 100%;
  background-color: var(--color-border);
}

/* ---- Gradient scrim — on every panel, always ---- */
.shop-by-craving__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(to top, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.28) 50%, rgba(0,0,0,0.06) 100%);
  transition: background 0.35s ease;
}

.shop-by-craving__panel[data-open="true"] .shop-by-craving__overlay {
  background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.05) 100%);
}

/* ---- Trigger — mobile: 64px tap bar ---- */
.shop-by-craving__trigger {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  height: 64px;
  padding-inline: 20px;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: start;
}

.shop-by-craving__trigger:focus-visible {
  outline: 2px solid rgba(255, 255, 255, 0.9);
  outline-offset: -4px;
}

/* ---- Category label (font-size / family from tw-text-* preset) ---- */
.shop-by-craving__category-name {
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #ffffff; /* fallback; overridden by block label_color if set */
}

/* ---- Revealed content — z-index 3 so CTA sits above full-tile trigger ---- */
.shop-by-craving__content {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
  padding-inline: 20px;
  padding-block-end: 24px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease 0.08s;
}

.shop-by-craving__panel[data-open="true"] .shop-by-craving__content {
  opacity: 1;
  pointer-events: auto;
}

/* ---- Tagline (font-size / family from tw-text-* preset) ---- */
.shop-by-craving__tagline {
  color: #ffffff; /* fallback; overridden by block tagline_color if set */
  margin: 0;
  line-height: 1.5;
}

/* ---- CTA ---- */
.shop-by-craving__cta {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
}

/* ============================================================
   Desktop (≥750px): slivers + hover-expand
   Collapsed = 80px fixed sliver. Active = fills remaining space.
   ============================================================ */
@media screen and (min-width: 750px) {
  .shop-by-craving__panels {
    flex-direction: row;
    min-height: 480px;
  }

  /* Collapsed sliver — fixed narrow width */
  .shop-by-craving__panel {
    max-height: none;
    flex: 0 0 80px;
    transition: flex-grow 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                flex-basis 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Active — fills all remaining space after slivers */
  .shop-by-craving__panel[data-open="true"] {
    flex: 1 0 0;
    max-height: none;
  }

  /* Full-tile hit zone: trigger stretches across the entire panel */
  .shop-by-craving__trigger {
    position: absolute;
    inset: 0;
    height: auto;
    align-items: flex-end;
    justify-content: flex-start;
    padding-block-end: 20px;
    padding-inline: 16px;
  }

  /* Label in sliver wraps to two stacked lines */
  .shop-by-craving__category-name {
    white-space: normal;
    word-break: break-word;
    line-height: 1.2;
    max-width: 100%;
  }

  /* Tagline + CTA float above the label row */
  .shop-by-craving__content {
    position: absolute;
    inset-block-end: 72px;
    inset-inline-start: 0;
    inset-inline-end: 0;
    padding-inline: 24px;
    padding-block-end: 0;
  }
}

/* ============================================================
   Reduced motion — disable blur, scale, transitions, auto-rotate
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .shop-by-craving__panel,
  .shop-by-craving__media,
  .shop-by-craving__image,
  .shop-by-craving__overlay,
  .shop-by-craving__content {
    transition: none;
  }

  .shop-by-craving__media {
    filter: none;
  }

  .shop-by-craving__panel[data-open="true"] .shop-by-craving__image {
    transform: scale(1);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Craving",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Craving"
    },
    {
      "type": "header",
      "content": "Auto-rotation"
    },
    {
      "type": "range",
      "id": "auto_rotation_interval",
      "label": "Rotation interval",
      "info": "Seconds between automatic panel changes. Pauses on hover or interaction.",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "craving-item",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "category_name",
          "label": "Category name",
          "default": "Chocolate Lover"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Indulge in rich, velvety chocolate arrangements."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "header",
          "content": "Label typography"
        },
        {
          "type": "select",
          "id": "label_type_preset",
          "label": "Label style",
          "info": "Use Label or Tag for best appearance in collapsed slivers.",
          "options": [
            { "value": "display", "label": "Display" },
            { "value": "h1", "label": "Heading 1" },
            { "value": "h2", "label": "Heading 2" },
            { "value": "h3", "label": "Heading 3" },
            { "value": "h4", "label": "Heading 4" },
            { "value": "h5", "label": "Heading 5" },
            { "value": "h6", "label": "Heading 6" },
            { "value": "body-regular", "label": "Body regular" },
            { "value": "body-small", "label": "Body small" },
            { "value": "label", "label": "Label" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "label"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Label color override"
        },
        {
          "type": "header",
          "content": "Tagline typography"
        },
        {
          "type": "select",
          "id": "tagline_type_preset",
          "label": "Tagline style",
          "options": [
            { "value": "display", "label": "Display" },
            { "value": "h1", "label": "Heading 1" },
            { "value": "h2", "label": "Heading 2" },
            { "value": "h3", "label": "Heading 3" },
            { "value": "h4", "label": "Heading 4" },
            { "value": "h5", "label": "Heading 5" },
            { "value": "h6", "label": "Heading 6" },
            { "value": "body-regular", "label": "Body regular" },
            { "value": "body-small", "label": "Body small" },
            { "value": "label", "label": "Label" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "body-regular"
        },
        {
          "type": "color",
          "id": "tagline_color",
          "label": "Tagline color override"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop by Craving",
      "blocks": [
        {
          "type": "craving-item",
          "settings": {
            "category_name": "Chocolate Lover",
            "tagline": "Indulge in rich, velvety chocolate arrangements.",
            "cta_label": "Shop Chocolate"
          }
        },
        {
