        {
          "type": "craving-item",
          "settings": {
            "category_name": "Savory Treats",
            "tagline": "Savory bites perfect for any celebration.",
            "cta_label": "Shop Savory"
          }
        }
      ]
    }
  ]
}
{% endschema %}
