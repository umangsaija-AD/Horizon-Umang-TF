{%- liquid
  assign block_count = section.blocks | size
-%}

<shop-by-craving
  id="ShopByCraving-{{ section.id }}"
  class="shop-by-craving color-{{ section.settings.color_scheme }} spacing-style"
  {% render 'spacing-style', settings: section.settings %}
>
  {%- if section.settings.heading != blank -%}
    <div class="shop-by-craving__header">
      <h2 class="shop-by-craving__heading tw-text-h2 tw-text-center">
        {{- section.settings.heading | escape -}}
      </h2>
    </div>
  {%- endif -%}

  <div class="shop-by-craving__panels">
    {%- for block in section.blocks -%}
      {%- if block.type == 'craving-item' -%}
        {%- assign panel_alt = block.settings.category_name | default: 'Category image' -%}
        <div
          class="shop-by-craving__panel"
          data-craving-panel
          data-open="false"
          {{ block.shopify_attributes }}
        >
          {%- comment -%} Background image {%- endcomment -%}
          <div class="shop-by-craving__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'shop-by-craving__image',
                  alt: panel_alt,
                  widths: '375,600,800,1200',
                  sizes: '(min-width: 750px) 33vw, 100vw'
              }}
            {%- else -%}
              <div class="shop-by-craving__image-placeholder"></div>
            {%- endif -%}
          </div>

          {%- comment -%} Dark overlay for text legibility {%- endcomment -%}
          <div class="shop-by-craving__overlay" aria-hidden="true"></div>

          {%- comment -%} Trigger button — always visible {%- endcomment -%}
          <button
            class="shop-by-craving__trigger"
            data-craving-trigger
            aria-expanded="false"
            type="button"
          >
            <span class="shop-by-craving__category-name">
              {{- block.settings.category_name | default: 'Category' | escape -}}
            </span>
          </button>

          {%- comment -%} Revealed content — tagline + CTA {%- endcomment -%}
          <div
            class="shop-by-craving__content"
            aria-hidden="true"
          >
            {%- if block.settings.tagline != blank -%}
              <p class="shop-by-craving__tagline tw-text-body-regular">
                {{- block.settings.tagline | escape -}}
              </p>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <a
                class="shop-by-craving__cta button"
                href="{{ block.settings.cta_url | default: '#' }}"
              >
                {{- block.settings.cta_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</shop-by-craving>

<script src="{{ 'shop-by-craving.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
/* ============================================================
   Shop by Craving — section styles
   Mobile-first: panels stack vertically, tap trigger to expand.
   Desktop (≥750px): panels expand horizontally on hover.
   The trigger button covers the full tile on desktop so any
   hover anywhere on the tile activates it.
   ============================================================ */

.shop-by-craving {
  display: flex;
  flex-direction: column;
}

/* ---- Section heading ---- */
.shop-by-craving__header {
  padding-block-end: 24px;
  width: 100%;
}

.shop-by-craving__heading {
  color: var(--color-foreground);
}

/* ---- Panels container ---- */
.shop-by-craving__panels {
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  gap: 8px;
}

/* ---- Individual panel ---- */
.shop-by-craving__panel {
  position: relative;
  overflow: hidden;
  max-height: 64px;
  transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.shop-by-craving__panel[data-open="true"] {
  max-height: 320px;
}

/* ---- Background image — scales up on active panel ---- */
.shop-by-craving__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.shop-by-craving__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transform: scale(1);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.shop-by-craving__panel[data-open="true"] .shop-by-craving__image {
  transform: scale(1.03);
}

.shop-by-craving__image-placeholder {
  width: 100%;
  height: 100%;
  background-color: var(--color-border);
}

/* ---- Gradient scrim — present on every panel for consistent legibility ---- */
.shop-by-craving__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(to top, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.28) 50%, rgba(0,0,0,0.06) 100%);
  transition: background 0.35s ease;
}

.shop-by-craving__panel[data-open="true"] .shop-by-craving__overlay {
  background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.05) 100%);
}

/* ---- Trigger button — mobile: 64px tap bar ---- */
.shop-by-craving__trigger {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  height: 64px;
  padding-inline: 20px;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: start;
}

.shop-by-craving__trigger:focus-visible {
  outline: 2px solid rgba(255, 255, 255, 0.9);
  outline-offset: -4px;
}

.shop-by-craving__category-name {
  font-family: var(--font-heading--family, var(--font-family, sans-serif));
  font-size: 1.125rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: #ffffff;
}

/* ---- Revealed content (tagline + CTA) ---- */
.shop-by-craving__content {
  position: relative;
  /* z-index 3 so CTA links sit above the full-panel trigger on desktop */
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
  padding-inline: 20px;
  padding-block-end: 24px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease 0.08s;
}

.shop-by-craving__panel[data-open="true"] .shop-by-craving__content {
  opacity: 1;
  pointer-events: auto;
}

/* ---- Tagline ---- */
.shop-by-craving__tagline {
  color: #ffffff;
  margin: 0;
  font-size: 0.9375rem;
  line-height: 1.5;
}

/* ---- CTA button ---- */
.shop-by-craving__cta {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
}

/* ============================================================
   Desktop (≥750px): horizontal flex-row, hover-to-expand
   ============================================================ */
@media screen and (min-width: 750px) {
  .shop-by-craving__panels {
    flex-direction: row;
    min-height: 480px;
  }

  .shop-by-craving__panel {
    max-height: none;
    flex: 1;
    transition: flex-grow 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .shop-by-craving__panel[data-open="true"] {
    flex: 3;
    max-height: none;
  }

  /* Full-tile hit zone — trigger covers the entire panel on desktop */
  .shop-by-craving__trigger {
    position: absolute;
    inset: 0;
    height: auto;
    align-items: flex-end;
    padding-block-end: 20px;
    padding-inline: 24px;
    justify-content: flex-start;
  }

  /* Content sits above the label row */
  .shop-by-craving__content {
    position: absolute;
    inset-block-end: 72px;
    inset-inline-start: 0;
    inset-inline-end: 0;
    padding-inline: 24px;
    padding-block-end: 0;
  }

  .shop-by-craving__category-name {
    font-size: 1.25rem;
  }
}

/* ============================================================
   Reduced motion — disable scale, auto-rotate paused in JS
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .shop-by-craving__panel,
  .shop-by-craving__image,
  .shop-by-craving__overlay,
  .shop-by-craving__content {
    transition: none;
  }

  .shop-by-craving__panel[data-open="true"] .shop-by-craving__image {
    transform: scale(1);
  }
}
{% endstylesheet %}

{% schema %}
{
