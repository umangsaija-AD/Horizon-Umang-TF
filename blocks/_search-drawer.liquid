<div
  {{ block.shopify_attributes }}
  class="search-drawer js-search-drawer"
  data-root-url="{{ routes.root_url }}"
>
  {%- comment -%} Search input — Enter submits to /search {%- endcomment -%}
  <form
    class="search-drawer__input-wrapper"
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    data-search-form
  >
    <input type="hidden" name="type" value="product">
    <input
      type="search"
      name="q"
      data-search-input
      class="search-drawer__input"
      placeholder="{{ block.settings.placeholder_text }}"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
    >
    <button
      type="button"
      data-search-clear
      class="search-drawer__clear-btn"
      aria-label="{{ 'search.clear_search' | t }}"
      style="display: none;"
    >
      {{ 'x.svg' | inline_asset_content }}
    </button>
  </form>

  {%- comment -%} Empty state: bestsellers + top searches {%- endcomment -%}
  <div class="search-drawer__empty-state" data-search-empty-state>
    {%- if block.settings.collection != blank -%}
      <div class="search-drawer__bestsellers">
        {%- if block.settings.title != blank -%}
          <h3 class="search-drawer__section-heading">{{ block.settings.title }}</h3>
        {%- endif -%}
        <div class="search-drawer__products-grid">
          {%- assign sd_visible = 0 -%}
          {%- for product in block.settings.collection.products -%}
            {%- if sd_visible >= 4 -%}{%- break -%}{%- endif -%}
            {%- unless product.metafields.seo.hidden.value == 1 -%}
            {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
            {% # theme-check-enable %}
            {%- assign sd_visible = sd_visible | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if block.settings.top_searchs != blank -%}
      {%- assign chips = block.settings.top_searchs | split: ',' -%}
      {%- if chips.size > 0 -%}
        <div class="search-drawer__top-searches">
          <h3 class="search-drawer__section-heading">{{ 'search.top_searches' | t }}</h3>
          <div class="search-drawer__chips">
            {%- for chip in chips -%}
              {%- assign chip_text = chip | strip -%}
              {%- if chip_text != blank -%}
                <a
                  href="{{ routes.search_url }}?q={{ chip_text | url_encode }}"
                  class="search-drawer__chip"
                >
                  {{- chip_text -}}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- comment -%} Loading indicator — shown while fetching results {%- endcomment -%}
  <div class="search-drawer__loading --hidden" data-search-loading aria-live="polite" role="status">
    <span class="search-drawer__spinner" aria-label="{{ 'search.searching' | t }}"></span>
  </div>

  {%- comment -%} Results container — populated by JS {%- endcomment -%}
  <div class="search-drawer__results --hidden" data-search-results></div>

  <script src="{{ 'native-search-drawer.js' | asset_url }}" type="module"></script>
</div>

{% stylesheet %}
  .search-drawer {
    display: none;
  }

  /* When drawer is open, flatten the header-wrapper's bottom corners AND
     suppress its downward box-shadow at the seam so the drawer + header
     look like one continuous floating box. The drawer carries its own
     matching shadow below. */
  .header-wrapper:has(.js-search-drawer.--is-open) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: none;
  }

  .search-drawer.--is-open {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #fff;
    border-top: 1px solid var(--color-gray-light);
    border-radius: 0 0 8px 8px;
    z-index: var(--layer-overlay);
    padding: 24px 16px;
    box-sizing: border-box;
    max-height: 80vh;
    overflow-y: auto;
  }

  @media screen and (min-width: 750px) {
    .search-drawer.--is-open {
      padding: 48px 64px 32px;
    }
  }

  /* Input */
  .search-drawer__input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-drawer__input {
    width: 100%;
    height: 48px;
    border: 1px solid #C6C6C6;
    border-radius: 8px;
    padding: 10px 48px 10px 16px;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 17px;
    color: var(--color-black-secondary);
    background: #fff;
    outline: none;
    box-sizing: border-box;
    -webkit-appearance: none;
    appearance: none;
  }

  .search-drawer__input::placeholder {
    color: #6B6B6B;
  }

  .search-drawer__input:focus {
    border-color: var(--color-black-light);
  }

  /* Hide WebKit's native clear button */
  .search-drawer__input::-webkit-search-cancel-button,
  .search-drawer__input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-drawer__clear-btn {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--color-black-secondary);
  }

  .search-drawer__clear-btn svg {
    width: 20px;
    height: 20px;
  }

  /* Empty state */
  .search-drawer__empty-state {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .search-drawer__empty-state.--hidden {
    display: none;
  }

  /* Section headings */
  .search-drawer__section-heading {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.12px;
    text-transform: uppercase;
    color: var(--color-black-light);
    margin: 0 0 24px;
  }

  /* Products grid */
  .search-drawer__bestsellers {
    display: flex;
    flex-direction: column;
  }

  .search-drawer__products-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 53%;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 4px;
    margin-right: -16px;
    padding-right: 16px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .search-drawer__products-grid::-webkit-scrollbar {
    display: none;
  }

  .search-drawer__products-grid > * {
    scroll-snap-align: start;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .search-drawer__products-grid {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      overflow-x: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
      margin-right: 0;
      padding-right: 0;
    }
  }

  /* Top searches chips */
  .search-drawer__top-searches {
    display: flex;
    flex-direction: column;
  }

  .search-drawer__chips {
    display: flex;
    flex-direction: row;
    gap: 8px;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .search-drawer__chips::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .search-drawer__chips {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }

  .search-drawer__chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border: 1px solid var(--color-gray-light);
    border-radius: 24px;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-black-secondary);
    text-decoration: none;
    white-space: nowrap;
    background: #fff;
    flex-shrink: 0;
  }

  .search-drawer__chip:hover {
    border-color: var(--color-black-light);
  }

  /* Loading */
  .search-drawer__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 0;
    width: 100%;
  }

  .search-drawer__loading.--hidden {
    display: none;
  }

  .search-drawer__spinner {
    display: block;
    width: 28px;
    height: 28px;
    border: 2px solid var(--color-gray-light);
    border-top-color: var(--color-black);
    border-radius: 50%;
    animation: search-drawer-spin 0.7s linear infinite;
  }

  @keyframes search-drawer-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-drawer__spinner {
      animation-duration: 2s;
    }
  }

  /* Results */
  .search-drawer__results {
    width: 100%;
  }

  .search-drawer__results.--hidden {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search Drawer",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Empty Search Field State",
      "info": "This is displayed when the search input is empty."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Search placeholder",
      "default": "Search florals, treats, and more"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "top_searchs",
      "label": "Top Searches",
      "info": "Add values separated by commas."
    }
  ],
  "presets": [
    {
      "name": "Search Drawer",
      "category": "t:categories.header"
    }
  ]
}
{% endschema %}
