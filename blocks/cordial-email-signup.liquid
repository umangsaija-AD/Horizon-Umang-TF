

{% liquid
  assign block_settings = block.settings
  assign button_size = block_settings.button_size | default: 'medium'
  assign success_message = block_settings.success_message
  assign error_message = block_settings.error_message
  assign consent_type_preset = block_settings.consent_type_preset | default: 'body-small'
  assign input_font_size = block_settings.input_font_size | default: 'md'
  assign entry_source = block_settings.entry_source | default: 'Shopify_Email_Signup'

  if input_font_size == 'lg' or input_font_size == '1.125rem'
    assign input_font_size_variable = '--font-size--lg'
  else
    assign input_font_size_variable = '--font-size--md'
  endif
%}
<cordial-email-signup
  class="cordial-email-signup-block size-style spacing-style"
  data-entry-source="{{ entry_source | escape }}"
  style="{% render 'size-style', settings: block_settings %}{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {% if block_settings.heading != blank %}
    <div class="cordial-email-signup__heading {{ block_settings.heading_preset }}">
      {{ block_settings.heading | escape }}
    </div>
  {% endif %}
  <form
    ref="form"
    class="cordial-email-signup__form spacing-style"
  >
    <div
      class="cordial-email-signup__input-group {% if block_settings.integrated_button and block_settings.border_style != 'underline' %}cordial-email-signup__input-group--integrated{% endif %} {% if block_settings.border_style == 'underline' %}cordial-email-signup__input-group--underline{% endif %} {% if block_settings.border_style == 'none' %}cordial-email-signup__input-group--no-border{% endif %} {% if block_settings.display_type == 'arrow' %}cordial-email-signup__input-group--arrow{% endif %} {% if block_settings.inherit_color_scheme == false %}color-{{ block_settings.color_scheme }}{% endif %}"
      style="--border-width: {{ block_settings.border_width }}px; --border-radius: {{ block_settings.border_radius }}px;"
    >
      <label
        for="CordialEmailInput-{{ block.id }}"
        class="visually-hidden"
      >
        {{ 'blocks.email_signup.label' | t }}
      </label>
      <input
        ref="emailInput"
        id="CordialEmailInput-{{ block.id }}"
        class="cordial-email-signup__input cordial-email-signup__input--{{ block_settings.border_style }} {{ block_settings.border_variation }}"
        style="--email-signup-input-font-size: var({{ input_font_size_variable }});"
        type="email"
        name="email"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
        required
        aria-describedby="Cordial-signup__message-error-{{ block.id }}"
      >
      <button
        ref="submitButton"
        type="submit"
        class="cordial-email-signup__button {% if block_settings.integrated_button or block_settings.border_style == 'underline' %}cordial-email-signup__button--integrated{% endif %} cordial-email-signup__button--{{ block_settings.display_type }} cordial-email-signup__button--size-{{ button_size }} {{ block_settings.style_class }} {{ block_settings.style_class }}--{{ block.id }} {% if block_settings.inherit_color_scheme == false %}color-{{ block_settings.color_scheme }}{% endif %}"
        {% if block_settings.display_type != 'text' %}
          aria-label="{{ 'actions.sign_up' | t }}"
        {% endif %}
      >
        {% if block_settings.display_type == 'text' %}
          {{ block_settings.label }}
        {% else %}
          <svg
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
            aria-hidden="true"
            class="cordial-email-signup__button-icon"
          >
            {% render 'icon', icon: 'arrow' %}
          </svg>
        {% endif %}
      </button>
      <span ref="successIcon" class="cordial-email-signup__success-icon svg-wrapper is-hidden">
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
      </span>
    </div>

    {%- if block_settings.show_consent_checkbox and block_settings.consent_text != blank -%}
      <div ref="consentContainer" class="cordial-email-signup__consent">
        <label class="cordial-email-signup__consent-label {{ consent_type_preset }}" for="CordialEmailConsent-{{ block.id }}">
          <input
            type="checkbox"
            name="accepts_marketing"
            value="true"
            id="CordialEmailConsent-{{ block.id }}"
            class="cordial-email-signup__consent-input"
            required
          >
          <span class="cordial-email-signup__consent-text rte">{{ block_settings.consent_text }}</span>
        </label>
      </div>
    {%- endif -%}

    <div
      ref="errorMsg"
      id="Cordial-signup__message-error-{{ block.id }}"
      class="cordial-email-signup__message label is-hidden"
      tabindex="-1"
      role="alert"
      aria-live="assertive"
    >
      <span class="cordial-email-signup__message-text">{{ error_message }}</span>
    </div>

    <div
      ref="successMsg"
      id="Cordial-signup__message-success-{{ block.id }}"
      class="cordial-email-signup__message label is-hidden"
      tabindex="-1"
      role="status"
      aria-live="polite"
    >
      <p class="cordial-email-signup__message-text">{{ success_message }}</p>
    </div>
  </form>
</cordial-email-signup>

{% javascript %}
  class CordialEmailSignup extends HTMLElement {
    #boundHandleSubmit = this.#handleSubmit.bind(this);

    connectedCallback() {
      this.form?.addEventListener('submit', this.#boundHandleSubmit);
    }

    disconnectedCallback() {
      this.form?.removeEventListener('submit', this.#boundHandleSubmit);
    }

    get form() {
      return this.querySelector('[ref="form"]');
    }

    get emailInput() {
      return this.querySelector('[ref="emailInput"]');
    }

    get errorMsg() {
      return this.querySelector('[ref="errorMsg"]');
    }

    get successMsg() {
      return this.querySelector('[ref="successMsg"]');
    }

    get submitButton() {
      return this.querySelector('[ref="submitButton"]');
    }

    get consentContainer() {
      return this.querySelector('[ref="consentContainer"]');
    }

    get successIcon() {
      return this.querySelector('[ref="successIcon"]');
    }

    #hideMessages() {
      this.errorMsg?.classList.add('is-hidden');
      this.successMsg?.classList.add('is-hidden');
    }

    #showError() {
      this.#hideMessages();

      const { errorMsg } = this;
      if (errorMsg) {
        errorMsg.classList.remove('is-hidden');
        errorMsg.focus();
      }
    }

    #handleSubmit(event) {
      event.preventDefault();

      const { form, emailInput, successMsg, submitButton, consentContainer, successIcon } = this;

      if (!form || !emailInput || !form.checkValidity()) {
        form?.reportValidity();
        return;
      }

      this.#hideMessages();

      const email = emailInput.value.trim();

      try {
        if (typeof crdl !== 'function') {
          console.warn('[Cordial] crdl() is not available. Ensure the Cordial app is installed.');
          this.#showError();
          return;
        }

        crdl(
          'contact',
          { email },
          {
            channels: {
              email: {
                subscribeStatus: 'subscribed',
              },
            },
            entry_source: this.dataset.entrySource,
          }
        );

        emailInput.value = email;
        emailInput.readOnly = true;
        if (successMsg) emailInput.setAttribute('aria-describedby', successMsg.id);
        submitButton?.classList.add('is-hidden');
        consentContainer?.classList.add('is-hidden');
        successIcon?.classList.remove('is-hidden');
        if (successMsg) {
          successMsg.classList.remove('is-hidden');
          successMsg.focus();
        }
      } catch (err) {
        console.warn('[Cordial] Email signup error:', err);
        this.#showError();
      }
    }
  }

  if (!customElements.get('cordial-email-signup')) {
    customElements.define('cordial-email-signup', CordialEmailSignup);
  }
{% endjavascript %}

{% stylesheet %}
  .cordial-email-signup-block {
    --arrow-button-size: 58px;
    --arrow-button-size-integrated: 42px;
    --arrow-button-size-small: 20px;
    --arrow-icon-size: 32px;
    --arrow-icon-size-small: 24px;

    min-width: fit-content;

    @media screen and (max-width: 749px) {
      width: 100%;
      min-width: unset;
    }
  }

  .cordial-email-signup__heading {
    padding-block: var(--padding-sm);
  }

  .cordial-email-signup__form {
    display: flex;
    flex-direction: column;
  }

  .cordial-email-signup__input-group {
    display: flex;
    align-items: stretch;
    background-color: transparent;
  }

  .cordial-email-signup__input-group:not(.cordial-email-signup__input-group--integrated):not(.cordial-email-signup__input-group--underline) {
    gap: var(--gap-xs);
    align-items: center;
  }

  .cordial-email-signup__input-group:not(.cordial-email-signup__input-group--arrow):not(.cordial-email-signup__input-group--underline):not(
      .cordial-email-signup__input-group--integrated
    ) {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  .cordial-email-signup__input-group--integrated {
    height: 50px;
    border-width: var(--border-width);
    border-radius: var(--border-radius);
    border-style: solid;
    border-color: var(--color-input-border);
    background-color: var(--color-input-background);
  }

  .cordial-email-signup__input-group--integrated.cordial-email-signup__input-group--no-border {
    border: none;
  }

  .cordial-email-signup__input {
    flex: 1;
    min-width: 0;
    color: var(--color-input-text);
    font-size: var(--email-signup-input-font-size);
    line-height: var(--font-body-regular--line-height);
    border-width: var(--border-width);
    border-radius: var(--border-radius);
    border-style: solid;
    border-color: var(--color-input-border);

    @media screen and (max-width: 749px) {
      width: 100%;
    }
  }

  .cordial-email-signup__input:focus-visible {
    outline: none;
  }

  .cordial-email-signup__input-group--integrated .cordial-email-signup__input {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding-block: 0;
    padding-inline: var(--padding-2xl) var(--padding-md);
  }

  .cordial-email-signup__button {
    white-space: nowrap;
    font-weight: 600;

    @media screen and (max-width: 749px) {
      width: 100%;
    }
  }

  .cordial-email-signup__input {
    padding: var(--padding-lg) var(--padding-2xl);
  }

  .cordial-email-signup__button--text {
    padding-block: var(--email-signup-button-padding-block);
    padding-inline: var(--email-signup-button-padding-inline);
    font-size: var(--email-signup-button-font-size);
  }

  .cordial-email-signup__button--size-small {
    --email-signup-button-padding-block: var(--button-padding-block-sm);
    --email-signup-button-padding-inline: var(--button-padding-inline-sm);
    --email-signup-button-font-size: var(--button-font-size-sm);
  }

  .cordial-email-signup__button--size-medium {
    --email-signup-button-padding-block: var(--button-padding-block-md);
    --email-signup-button-padding-inline: var(--button-padding-inline-md);
    --email-signup-button-font-size: var(--button-font-size-md);
  }

  .cordial-email-signup__button--size-large {
    --email-signup-button-padding-block: var(--button-padding-block-lg);
    --email-signup-button-padding-inline: var(--button-padding-inline-lg);
    --email-signup-button-font-size: var(--button-font-size-lg);
  }

  .cordial-email-signup__input-group--underline {
    --box-shadow-color: var(--color-input-border);
    --box-shadow-multiplier: 1;
    --box-shadow-focused-multiplier: 1.75;

    box-shadow: 0 calc(var(--border-width) * var(--box-shadow-multiplier)) 0 var(--box-shadow-color);
    transition: box-shadow var(--animation-values);
    margin-block-end: calc(var(--border-width) * var(--box-shadow-focused-multiplier));

    &:focus-within {
      --box-shadow-multiplier: var(--box-shadow-focused-multiplier);
      --box-shadow-color: var(--color-input-text);
    }
  }

  .cordial-email-signup__input-group .cordial-email-signup__input--underline {
    color: var(--color-input-text);
    background-color: transparent;
    padding: 12px 0;
    border: none;
    border-radius: 0;
  }

  .cordial-email-signup__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-70));
  }

  .cordial-email-signup__input-group .cordial-email-signup__input--none {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border: none;
  }

  .cordial-email-signup__button-icon {
    color: currentcolor;
    padding: 5px;

    @media screen and (max-width: 749px) {
      padding: 0;
      align-self: center;
      justify-self: center;
      width: var(--icon-size-lg);
      height: var(--icon-size-lg);
    }
  }

  .cordial-email-signup__button--arrow {
    width: var(--arrow-button-size-small);
    height: var(--arrow-button-size-small);
    padding: 0;

    &:not(.cordial-email-signup__button--integrated) {
      width: var(--arrow-button-size);
      height: var(--arrow-button-size);
      display: flex;
      align-items: center;
      justify-content: center;

      > .cordial-email-signup__button-icon {
        width: var(--arrow-icon-size);
        height: var(--arrow-icon-size);
        padding: 0;
      }
    }
  }

  .cordial-email-signup__button--integrated {
    --button-offset: var(--padding-2xs);
    align-self: center;
    margin: var(--button-offset);
    flex-shrink: 0;

    @media screen and (max-width: 749px) {
      width: fit-content;
    }

    &.button-unstyled {
      border-radius: var(--border-radius);
    }

    > .cordial-email-signup__button-icon {
      padding: 0;
    }

    &.cordial-email-signup__button--arrow {
      width: var(--arrow-button-size-integrated);
      height: var(--arrow-button-size-integrated);
      align-self: center;
      display: flex;
      align-items: center;
      justify-content: center;

      > .cordial-email-signup__button-icon {
        width: var(--arrow-icon-size-small);
        height: var(--arrow-icon-size-small);
      }
    }
  }

  .cordial-email-signup__input--underline + .cordial-email-signup__button--integrated {
    margin: 0;
    align-self: center;

    &.cordial-email-signup__button--text.button-unstyled {
      min-width: 44px;
      min-height: 44px;
    }

    &.button-unstyled {
      border-radius: 0;
    }

    &.cordial-email-signup__button--arrow {
      width: var(--arrow-button-size-integrated);
      height: var(--arrow-button-size-integrated);
      display: flex;
      align-items: center;
      justify-content: center;

      > .cordial-email-signup__button-icon {
        width: var(--arrow-icon-size-small);
        height: var(--arrow-icon-size-small);
      }
    }
  }

  .cordial-email-signup__button:not(.button-unstyled) {
    background-color: var(--button-background-color);
    color: var(--button-color);
    text-transform: var(--button-text-case-primary);
  }

  .cordial-email-signup__button.button-secondary {
    text-transform: var(--button-text-case-secondary);
  }

  .cordial-email-signup__button.button-unstyled {
    background-color: transparent;
    color: var(--color-input-text);
  }

  .cordial-email-signup__button.button-unstyled:hover {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-70));
    cursor: pointer;
  }

  .cordial-email-signup__message {
    display: flex;
    align-items: center;
    margin-block-start: var(--gap-xs);
  }

  .cordial-email-signup-block .is-hidden {
    display: none;
  }

  .cordial-email-signup__success-icon {
    flex-shrink: 0;
    align-self: center;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    margin-inline-end: var(--padding-2xl);
    color: var(--color-input-text);
  }

  .cordial-email-signup__message-text {
    margin: 0;
  }

  .cordial-email-signup__consent {
    margin-block-start: var(--gap-xs);
    max-width: 100%;
  }

  .cordial-email-signup__consent .cordial-email-signup__consent-label:has(.cordial-email-signup__consent-input) {
    display: flex;
    align-items: flex-start;
    gap: var(--padding-xs);
    cursor: pointer;
    color: var(--color-foreground);
    text-wrap: pretty;
  }

  .cordial-email-signup__consent-input {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-inline-end: 0;
    border: 1px solid var(--color-input-border);
    border-radius: 4px;
    background-color: var(--color-input-background);
  }

  .cordial-email-signup__consent-input:not(:disabled):not(:checked):hover {
    border-color: var(--color-input-border);
    background-color: var(--color-input-hover-background);
  }

  .cordial-email-signup__consent-input:checked {
    border-color: var(--color-primary-button-background);
    background-color: var(--color-primary-button-background);
  }

  .cordial-email-signup__consent-input:not(:disabled):hover:checked {
    border-color: var(--color-primary-button-background);
    background-color: var(--color-primary-button-background);
  }

  .cordial-email-signup__consent-input:checked::after {
    background-color: var(--color-input-background);
  }

  .cordial-email-signup__consent-text {
    margin: 0;
  }

  .cordial-email-signup__consent-text :is(p, ul, ol) {
    margin: 0;
  }

  .cordial-email-signup__consent-text a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.12em;
  }

  .cordial-email-signup__consent-text a:hover {
    color: var(--color-primary-hover);
    text-decoration-color: transparent;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cordial_email_signup",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.cordial_email_signup_info"
    },
    {
      "type": "text",
      "id": "entry_source",
      "label": "t:settings.entry_source",
      "info": "t:info.cordial_entry_source",
      "default": "Shopify_Email_Signup"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fill",
