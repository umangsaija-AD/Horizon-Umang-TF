{% liquid
  assign block_settings = block.settings
  assign menu = block_settings.menu
  assign type_preset = block_settings.type_preset | default: 'body-regular'
%}

{% if menu != blank and menu.links.size > 0 %}
  <nav
    class="
      links-block
      spacing-style
      text-block
      text-block--{{ block.id }}
      {% if type_preset == 'custom' %}
        custom-typography
        {% if block_settings.font_size != '' %}custom-font-size{% endif %}
        {% if block_settings.weight != '' %}custom-font-weight{% endif %}
      {% else %}
        {{ type_preset }}
      {% endif %}
    "
    style="
      --links-gap: {{ block_settings.link_gap }}px;
      --links-direction: {{ block_settings.layout_direction }};
      {% if block_settings.link_font_weight != blank %}--links-font-weight: {{ block_settings.link_font_weight }};{% endif %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'typography-style', settings: block_settings, preset: type_preset %}
    "
    aria-label="{{ menu.title | escape }}"
    {{ block.shopify_attributes }}
  >
    <ul class="list-unstyled links-block__list">
      {% for link in menu.links %}
        <li class="links-block__item">
          <a href="{% render 'localized-url', url: link.url %}">{{ link.title }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .links-block {
    width: 100%;
  }

  .links-block__list {
    display: flex;
    flex-wrap: wrap;
    flex-direction: var(--links-direction, column);
    gap: var(--links-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links-block a {
    --button-color: var(--color-foreground);
    color: var(--color-foreground);
    font-weight: var(--links-font-weight, inherit);
    text-decoration-color: currentcolor;
  }

  .links-block a:hover {
    text-decoration-color: transparent;
    color: var(--color-primary-hover);
  }
{% endstylesheet %}

