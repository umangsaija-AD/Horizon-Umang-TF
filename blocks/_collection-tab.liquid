<div
  role="tabpanel"
  ref="panels[]"
  class="collection-tab-panel"
  id="CollectionPanel-{{ block.id }}-{{ section.id }}"
  aria-labelledby="CollectionTab-{{ block.id }}-{{ section.id }}"
  data-tab-title="{{ block.settings.title }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.collection_list != blank %}
    <div class="collection-tab-panel__cards">
      {% for collection in block.settings.collection_list %}
        <a href="{{ collection.url }}" class="collection-tab-card" data-testid="collection-tab-card">
          <div class="collection-tab-card__image-wrapper">
            {%- if collection.image -%}
              {%- liquid
                assign sizes = '(min-width: 1200px) 240px, (min-width: 750px) 200px, 160px'
                assign widths = '160, 200, 240, 320, 400, 480'
              -%}
              {{
                collection.image
                | image_url: width: 480
                | image_tag: loading: 'lazy', class: 'collection-tab-card__image', sizes: sizes, widths: widths
              }}
            {%- elsif collection.products.first.featured_image -%}
              {{
                collection.products.first.featured_image
                | image_url: width: 480
                | image_tag:
                  loading: 'lazy',
                  class: 'collection-tab-card__image',
                  sizes: '(min-width: 1200px) 240px, (min-width: 750px) 200px, 160px',
                  widths: '160, 200, 240, 320, 400, 480'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-tab-card__placeholder' }}
            {%- endif -%}

            {%- assign highlight_text = collection.metafields.custom.highlight_text -%}
            {%- if highlight_text != blank -%}
              <span class="collection-tab-card__highlight">
                {{- highlight_text -}}
              </span>
            {%- endif -%}
          </div>

          <p
            class="collection-tab-card__title {{ section.settings.card_type_preset }}"
            style="
              {%- if section.settings.card_weight != blank %}font-weight: {{ section.settings.card_weight }};{% endif -%}
              {%- if section.settings.card_font_size != blank %}font-size: {{ section.settings.card_font_size }};{% endif -%}
            "
          >
            {{ collection.title }}
          </p>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="collection-tab-panel__cards">
      {% for i in (1..5) %}
        <div class="collection-tab-card collection-tab-card--placeholder">
          <div class="collection-tab-card__image-wrapper">
            {{ 'collection-1' | placeholder_svg_tag: 'collection-tab-card__placeholder' }}
          </div>
          <p
            class="collection-tab-card__title {{ section.settings.card_type_preset }}"
            style="
              {%- if section.settings.card_weight != blank %}font-weight: {{ section.settings.card_weight }};{% endif -%}
              {%- if section.settings.card_font_size != blank %}font-size: {{ section.settings.card_font_size }};{% endif -%}
            "
          >
            Collection {{ i }}
          </p>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .collection-tab-panel__cards {
    z-index: 1;
    display: flex;
    gap: 1.375rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-block-start: 3.5rem;
    padding-block-end: 1.5rem;
  }

  .collection-tab-panel__cards::-webkit-scrollbar {
    display: none;
  }

  .collection-tab-card {
    flex: 0 0 264px;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    transition: transform 0.2s ease;
  }

  .collection-tab-card:hover,
  .collection-tab-card:focus-visible {
    outline: none;
    transform: scale(1.05);
  }

  .collection-tab-card:hover *,
  .collection-tab-card:focus-visible * {
    text-decoration: underline;
  }

  .collection-tab-card__image-wrapper {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    width: 264px;
    height: 264px;
    background-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 5px 20px 0 rgba(0, 0, 0, 0.1);
  }

  .collection-tab-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-tab-card__placeholder {
    width: 100%;
    height: 100%;
  }

  .collection-tab-card__highlight {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    background-color: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    white-space: nowrap;
    pointer-events: none;
  }

  .collection-tab-card__title {
    margin: 0;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  @media (min-width: 750px) {
    .section--page-width .collection-tab-panel__cards {
      padding-inline: var(--util-page-margin-offset);
      scroll-padding-inline-start: var(--util-page-margin-offset);
    }
  }

  @media (max-width: 749px) {
    .collection-tab-panel__cards {
      padding-block-start: 2.5rem;
      gap: 1rem;
      scroll-padding-inline-start: 1rem;
    }

    .collection-tab-card {
      flex: 0 0 138px;
      gap: 0.375rem;
      text-align: left;
    }

    .collection-tab-card__image-wrapper {
      width: 138px;
      height: 138px;
    }

    .collection-tab-card:first-child {
      margin-inline-start: 1rem;
    }

    .collection-tab-card:last-child {
      margin-inline-end: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.collection_tab_title",
      "default": "Tab"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:settings.collection_list"
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_tab"
    }
  ]
}
{% endschema %}
