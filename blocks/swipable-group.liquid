{%- capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{%- liquid
  assign is_overflow_full = false
  if block.settings.enable_swipe and block.settings.overflow_width == 'full'
    assign is_overflow_full = true
  endif
-%}

{% render 'swipable-group',
  children: children,
  settings: block.settings,
  shopify_attributes: block.shopify_attributes,
  class: block.settings.css_class,
  slide_count: block.blocks.size,
  is_overflow_full: is_overflow_full
%}

{% schema %}
{
  "name": "Swipable Group",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    },
    {
      "type": "_ugc-group"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Swipe"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe",
      "label": "Enable swipe",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_desktop",
      "label": "Show arrows (desktop)",
      "default": true,
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Show arrows (mobile)",
      "default": false,
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "select",
      "id": "arrows_position",
      "label": "Arrow position",
      "options": [
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "top-left",
          "label": "Top left"
        }
      ],
      "default": "bottom-right",
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "select",
      "id": "arrows_icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "caret",
          "label": "t:options.chevrons"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "header",
      "content": "t:content.layout",
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "select",
      "id": "overflow_width",
      "label": "Overflow width",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Gap (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "Mobile card size",
      "options": [
        {
          "value": "79cqw",
          "label": "Large"
        },
        {
          "value": "53cqw",
          "label": "Medium"
        },
        {
          "value": "48cqw",
          "label": "Small"
        }
      ],
      "default": "79cqw",
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "select",
      "id": "content_aspect_ratio",
      "label": "Card aspect ratio (desktop)",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "16 / 9", "label": "16:9 (Landscape)" },
        { "value": "3 / 2", "label": "3:2 (Photo)" },
        { "value": "4 / 3", "label": "4:3 (Classic)" },
        { "value": "1", "label": "1:1 (Square)" },
        { "value": "4 / 5", "label": "4:5 (Portrait)" },
        { "value": "9 / 16", "label": "9:16 (Vertical)" },
        { "value": "41 / 64", "label": "41:64 (Vertical)" }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "select",
      "id": "content_aspect_ratio_mobile",
      "label": "Card aspect ratio (mobile)",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "16 / 9", "label": "16:9 (Landscape)" },
        { "value": "3 / 2", "label": "3:2 (Photo)" },
        { "value": "4 / 3", "label": "4:3 (Classic)" },
        { "value": "1", "label": "1:1 (Square)" },
        { "value": "4 / 5", "label": "4:5 (Portrait)" },
        { "value": "9 / 16", "label": "9:16 (Vertical)" },
        { "value": "52 / 81", "label": "52:81 (Vertical)" }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "range",
      "id": "arrows_gap",
      "label": "Arrows gap from carousel",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.enable_swipe }}"
    },
    {
      "type": "header",
      "content": "Non-swipe layout",
      "visible_if": "{{ block.settings.enable_swipe == false }}"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "row",
      "visible_if": "{{ block.settings.enable_swipe == false }}"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.enable_swipe == false and block.settings.content_direction == 'row' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "t:settings.css_class"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Swipable Group",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
