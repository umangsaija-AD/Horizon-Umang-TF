{% doc %}
  Catering Cart Bar

  Sticky bottom cart bar for catering session-based cart.
  Shows cart items, subtotal, and checkout button.
  Hidden by default; shown when items are added via catering-cart.js.

  Styles are scoped and self-contained (no Tailwind dependency) so the bar
  renders reliably regardless of the compiled utility-class bundle. The
  JS-rendered item cards (catering-cart.js) and variant drawer
  (catering-variant-drawer.js) use the BEM classes defined in this <style>
  block — keep their markup and these selectors in sync.

  @example {% render 'catering-cart-bar' %}
{% enddoc %}

<style>
  .catering-cart-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    background: #fbf7f5;
    border-top: 1px solid #ededed;
    transform: translateY(100%);
    transition: transform 300ms ease;
    visibility: hidden;
  }

  .catering-cart-bar.is-visible {
    transform: translateY(0);
    visibility: visible;
  }

  .catering-cart-bar__inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
  }

  /* Cart items — horizontally scrollable. Scrollbar is hidden so it never
     reserves layout space; scrolling overlays the cards (trackpad/touch/drag). */
  .catering-cart-bar__items {
    display: flex;
    flex: 1 1 auto;
    gap: 12px;
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* legacy Edge/IE */
  }

  .catering-cart-bar__items::-webkit-scrollbar {
    display: none; /* WebKit/Blink */
  }

  /* Mobile: subtotal stacked & left-aligned on the left, CTA block on the right. */
  .catering-cart-bar__summary {
    display: flex;
    flex: 0 0 auto;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .catering-cart-bar__total {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .catering-cart-bar__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .catering-cart-bar__subtotal-label {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 22px;
    color: #5f0300;
  }

  .catering-cart-bar__subtotal-value {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 22px;
    color: #5f0300;
  }

  .catering-cart-bar__checkout {
    width: 100%;
    border: none;
    border-radius: 24px;
    padding: 10px 24px;
    background: #e10600;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .catering-cart-bar__checkout:disabled {
    background: #aaaaaa;
    cursor: not-allowed;
  }

  .catering-cart-bar__min-message {
    margin: 0;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 17px;
    color: #464646;
  }

  .catering-cart-bar__min-message.is-hidden {
    display: none;
  }

  /* Checkout failure message (Storefront API error / misconfiguration). */
  .catering-cart-bar__error {
    margin: 0;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 17px;
    color: #e10600;
  }

  .catering-cart-bar__error.is-hidden {
    display: none;
  }

  /* Shown (in place of the minimum message) once the $100 minimum is met. */
  .catering-cart-bar__free-delivery {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 17px;
    color: #5f0300;
  }

  .catering-cart-bar__free-delivery svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .catering-cart-bar__free-delivery.is-hidden {
    display: none;
  }

  /* Loading spinner shown on a product card's ATC button while variant
     data is being fetched (managed by catering-cart.js). */
  .catering-atc-spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-top-color: #ffffff;
    border-radius: 50%;
    vertical-align: middle;
    animation: catering-atc-spin 0.6s linear infinite;
  }

  @keyframes catering-atc-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Applied to a product card's ATC button while its variant data is fetched.
     Scoped under [data-catering-atc] so it reliably overrides the theme button's
     own display rules and centres the spinner (managed by catering-cart.js). */
  [data-catering-atc] .catering-atc-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  /* Make the catering ATC button full width on mobile too (desktop already is).
     Higher specificity than the theme's `.size-style` width rules, so it wins
     at every breakpoint; on desktop --size-style-width is already 100%. */
  [data-catering-atc] .size-style {
    width: 100%;
    min-height: 40px;
  }

  /* Per-card quantity stepper (sits above the ADD button). */
  .catering-qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 32px;
    margin-bottom: 8px;
    border: 1px solid #dbdbdb;
    border-radius: 8px;
    background: #ffffff;
    overflow: hidden;
  }

  .catering-qty__btn {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    color: #1d1d1d;
    cursor: pointer;
  }

  .catering-qty__btn:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .catering-qty__count {
    flex: 0 0 auto;
    width: 48px;
    min-width: 0;
    padding: 0;
    border: none;
    background: transparent;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #1d1d1d;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  /* iOS Safari (webkit) auto-zooms inputs with font-size < 16px on focus.
     Bump to 16px on iOS only so the field doesn't zoom; desktop keeps 14px. */
  @supports (-webkit-touch-callout: none) {
    .catering-qty__count {
      font-size: 16px;
    }
  }

  .catering-qty__count:focus {
    outline: none;
  }

  .catering-qty__count::-webkit-outer-spin-button,
  .catering-qty__count::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* ── Cart item card (rendered by catering-cart.js → buildCartItemHtml) ── */
  .catering-cart-item {
    position: relative;
    display: flex;
    gap: 8px;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #ededed;
    background: #ffffff;
    max-width: 296px;
    flex-shrink: 0;
  }

  .catering-cart-item__media {
    width: 64px;
    height: 64px;
    border-radius: 4px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .catering-cart-item__media--placeholder {
    background: linear-gradient(180deg, #f2e7df 0%, #f5f1f1 100%);
  }

  .catering-cart-item__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .catering-cart-item__heading {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .catering-cart-item__title,
  .catering-cart-item__variant {
    font-family: 'Poppins', sans-serif;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .catering-cart-item__title {
    font-weight: 500;
    font-size: 12px;
    line-height: 17px;
    color: #000000;
    width: 80%;
  }

  .catering-cart-item__variant {
    font-weight: 400;
    font-size: 12px;
    line-height: 17px;
    color: #6b6b6b;
  }

  .catering-cart-item__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .catering-cart-item__price {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 17px;
    color: #1d1d1d;
    text-align: right;
  }

  .catering-cart-item__stepper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 1px 8px;
    border: 1px solid #dbdbdb;
    border-radius: 8px;
  }

  .catering-cart-item__step {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    background: transparent;
    color: #1d1d1d;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }

  .catering-cart-item__step:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  /* Fixed width so a large quantity overflows/clips here instead of widening
     the stepper and the cart item card. */
  .catering-cart-item__count {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #1d1d1d;
    width: 32px;
    min-width: 0;
    flex-shrink: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: center;
  }

  .catering-cart-item__remove {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  /* ── Variant selector drawer (rendered by catering-variant-drawer.js) ── */
  .catering-variant-drawer {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .catering-variant-drawer__body {
    flex: 1 1 auto;
    padding: 24px 0;
  }

  .catering-variant-drawer__title {
    margin: 0 0 24px 0;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 22px;
    color: #1d1d1d;
  }

  .catering-variant-drawer__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .catering-variant-drawer__footer {
    position: sticky;
    bottom: -1.5rem;
    margin-block-start: auto;
    margin-inline: -24px;
    padding: 16px 24px;
    background: #ffffff;
    border-top: 1px solid #ededed;
    z-index: 1;
  }

  .catering-variant-drawer__add {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border: none;
    border-radius: 24px;
    padding: 10px 24px;
    background: #e10600;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .catering-variant-drawer__add:disabled {
    background: #aaaaaa;
    cursor: not-allowed;
  }

  /* ── Variant card (rendered by catering-variant-drawer.js → buildVariantCardHtml) ── */
  .catering-variant-card {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #c6c6c6;
    background: #ffffff;
    cursor: pointer;
    transition: border-color 150ms ease;
  }

  .catering-variant-card.is-selected {
    border-color: #1D1D1D;
  }

  .catering-variant-card.is-unavailable {
    opacity: 0.4;
    cursor: default;
  }

  .catering-variant-card__media {
    width: 55px;
    height: 55px;
    border-radius: 4px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .catering-variant-card__media--placeholder {
    background: linear-gradient(180deg, #f2e7df 0%, #f5f1f1 100%);
  }

  .catering-variant-card__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .catering-variant-card__name {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #1d1d1d;
  }

  .catering-variant-card.is-selected .catering-variant-card__name {
    font-weight: 600;
  }

  .catering-variant-card__price {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #1d1d1d;
  }

  .catering-variant-card__note {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 17px;
    color: #e10600;
  }

  @media screen and (min-width: 1024px) {
    .catering-cart-bar__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 16px 32px 16px 24px;
    }

    .catering-cart-bar__summary {
      width: 256px;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    .catering-cart-bar__total {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .catering-cart-bar__cta {
      width: 100%;
    }

    .catering-qty {
      height: 40px;
    }
  }
</style>

<div data-catering-cart-bar class="catering-cart-bar">
  <div class="catering-cart-bar__inner">
    <!-- Cart items (horizontally scrollable) -->
    <div data-cart-items class="catering-cart-bar__items"></div>

    <!-- Cart summary -->
    <div data-cart-summary class="catering-cart-bar__summary">
      <div class="catering-cart-bar__total">
        <span class="catering-cart-bar__subtotal-label">Subtotal</span>
        <span data-cart-total class="catering-cart-bar__subtotal-value">$0.00</span>
      </div>
      <div class="catering-cart-bar__cta">
        <button data-checkout-btn type="button" disabled class="catering-cart-bar__checkout">
          Review &amp; Checkout
        </button>
        <p data-min-message class="catering-cart-bar__min-message is-hidden">
          A $100 minimum is required for checkout.
        </p>
        <p data-free-delivery class="catering-cart-bar__free-delivery is-hidden">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m7.5 4.27 9 5.15" />
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
            <path d="m3.3 7 8.7 5 8.7-5" />
            <path d="M12 22V12" />
          </svg>
          Free delivery unlocked!
        </p>
        <p data-checkout-error class="catering-cart-bar__error is-hidden" role="alert"></p>
      </div>
    </div>
  </div>
</div>

<script>
  window.cateringCheckoutConfig = {
    token: {{ settings.catering_storefront_token | json }},
    domain: {{ shop.permanent_domain | json }},
    apiVersion: '2025-04'
  };
</script>
<script src="{{ 'catering-cart.js' | asset_url }}" type="module"></script>
<script src="{{ 'catering-variant-drawer.js' | asset_url }}" type="module"></script>
