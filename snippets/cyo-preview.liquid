{% doc %}
Renders the CYO "Your Box" preview slide content.

Displays a grid of slots driven by `cyo_total_slots`, each showing either an
empty-slot placeholder or a filled product image. Includes a branded bottom
banner (EA logo on red), a "Clear Selected" button, and a "Trending Now!" badge.

@param {object} product - The product object (for metafield access)
@param {number} total_slots - The number of slots to render
@param {object} [block_settings] - Block settings for media_radius etc.
@param {string} [empty_slot_image_url] - URL for the empty slot placeholder image

@example
{% render 'cyo-preview', product: product, total_slots: 12, block_settings: block.settings %}
{% enddoc %}

{%- liquid
  assign total_slots = total_slots | default: 12
  assign media_radius = block_settings.media_radius | default: 8

  assign cyo_empty_images = product.metafields.ediblearrangement.cyo_empty_slot_image.value
  assign cyo_empty_image_url = blank
  if cyo_empty_images != blank and cyo_empty_images.size > 0
    assign cyo_empty_image_url = cyo_empty_images[0] | image_url: width: 144
  endif

  if total_slots <= 16
    assign grid_columns = 4
    assign grid_max_width = 558
  elsif total_slots <= 24
    assign grid_columns = 5
    assign grid_max_width = 500
  else
    assign grid_columns = 6
    assign grid_max_width = 520
  endif
-%}

<div
  class="cyo-preview"
  data-cyo-preview
  style="--cyo-media-radius: {{ media_radius }}px; --cyo-grid-columns: {{ grid_columns }}; --cyo-grid-max-width: {{ grid_max_width }}px;"
>
  <div class="cyo-preview__badge">
    <span class="cyo-preview__badge-text">{{ 'cyo.trending_now' | t }}</span>
  </div>

  <div class="cyo-preview__stage">
    <div class="cyo-preview__grid">
      {%- for i in (1..total_slots) -%}
        {%- assign slot_index = forloop.index0 -%}
        <div class="cyo-preview__slot" data-cyo-slot="{{ slot_index }}">
          <div class="cyo-preview__slot-empty" data-cyo-slot-empty>
            {%- if cyo_empty_image_url != blank -%}
              <img
                class="cyo-preview__slot-placeholder"
                src="{{ cyo_empty_image_url }}"
                alt=""
                width="72"
                height="72"
                loading="eager"
                fetchpriority="high"
              >
            {%- else -%}
              <svg class="cyo-preview__slot-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3"/>
                <line x1="12" y1="7" x2="12" y2="17" stroke="currentColor" stroke-width="1"/>
                <line x1="7" y1="12" x2="17" y2="12" stroke="currentColor" stroke-width="1"/>
              </svg>
            {%- endif -%}
          </div>
          <img
            class="cyo-preview__slot-image"
            data-cyo-slot-image
            alt=""
            width="72"
            height="72"
            loading="lazy"
          >
        </div>
      {%- endfor -%}
    </div>

    <div class="cyo-preview__banner">
      <div class="cyo-preview__banner-inner">
        <img
          src="{{ '2023-ediblelogomatrix-final-ea-logodotcom-white.svg' | asset_url }}"
          alt="Edible Arrangements"
          class="cyo-preview__banner-logo"
          width="98"
          height="20"
          loading="eager"
        >
      </div>
    </div>
  </div>

  {% render 'cyo-clear' %}
</div>

{% stylesheet %}
  .cyo-preview {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(242, 231, 223, 1) 0%, rgba(245, 241, 241, 1) 100%);
    border-radius: var(--cyo-media-radius, 8px);
    overflow: hidden;
  }

  .cyo-preview__badge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    background-color: #ffffff;
    padding: 2px 12px;
    border-radius: 0 24px 24px 0;
  }

  .cyo-preview__badge-text {
    font-size: var(--font-size--sm);
    line-height: 1.43;
    font-weight: 400;
    color: var(--color-black-secondary);
  }

  .cyo-preview__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    width: 100%;
    padding: 40px 40px 0;
  }

  .cyo-preview__grid {
    display: grid;
    grid-template-columns: repeat(var(--cyo-grid-columns, 4), 1fr);
    gap: 0px;
    width: 100%;
    max-width: min(var(--cyo-grid-max-width, 558px), 100%);
  }

  .cyo-preview__slot {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cyo-preview__slot-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #c6c6c6;
  }

  .cyo-preview__slot-placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cyo-preview__slot-icon {
    width: 32px;
    height: 32px;
  }

  .cyo-preview__slot-image {
    display: none;
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    height: 80%;
    object-fit: cover;
    border-radius: 0;
    box-shadow: 0 3px 3px rgba(0, 0, 0, 0.25);
    z-index: 1;
  }

  .cyo-preview__slot[data-filled="true"] .cyo-preview__slot-image {
    display: block;
  }

  .cyo-preview__slot[data-filled="true"] .cyo-preview__slot-empty {
    display: none;
  }

  .cyo-preview__banner {
    width: 100%;
    position: relative;
  }

  .cyo-preview__banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 12px 0;
    background-color: #c11813;
    border: 2px solid #ffffff;
    border-radius: 0 0 8px 8px;
  }

  .cyo-preview__banner-logo {
    width: 98px;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .cyo-preview {
      position: sticky;
      top: var(--header-height, 0px);
      z-index: 1;
    }

    .cyo-preview__stage {
      padding: 24px 16px 0;
    }

    .cyo-preview__slot-icon {
      width: 20px;
      height: 20px;
    }

    .cyo-preview__badge-text {
      font-size: var(--font-size--2xs);
      line-height: 1.42;
    }

    .cyo-preview__banner-inner {
      padding: 8px 0;
    }

    .cyo-preview__banner-logo {
      width: 72px;
    }
  }
{% endstylesheet %}
