{%- doc -%}
  Renders a background media

  @param {string} [background_media] - The background media
  @param {object} [background_video] - The background video
  @param {string} [background_video_position] - The background video position
  @param {object} [background_image] - The desktop background image
  @param {object} [background_image_mobile] - The mobile background image (falls back to desktop when blank)
  @param {string} [background_image_position] - The background image position
  @param {string} [placeholder] - The placeholder
  @param {object} [block] - The block object
  @param {object} [section] - The section object

  @example
  {% render 'background-media', background_media: background_media, background_video: background_video, background_video_position: background_video_position, background_image: background_image, background_image_mobile: background_image_mobile, background_image_position: background_image_position, placeholder: placeholder %}
{%- enddoc -%}

{% if background_media == 'video' %}
  {% liquid
    assign video_classes = 'video-background video-background--' | append: background_video_position
  %}
  {%- if background_video != blank -%}
    <video-background-component
      class="{{ video_classes }}"
    >
      {% liquid
        assign media_width_desktop = 100 | append: 'vw'
        assign media_width_mobile = '100vw'
        assign sizes = '(min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
        assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
      %}
      {{
        background_video.preview_image
        | image_url: width: 3840
        | image_tag: width: 1100, widths: widths, sizes: sizes
      }}
      <video
        playsinline
        muted
        autoplay
        loop
        ref="videoElement"
      >
        {%- for sourceElement in background_video.sources -%}
          <source
            data-video-source="{{ sourceElement.url }}"
            type="{{ sourceElement.mime_type }}"
            ref="videoSources[]"
          >
        {%- endfor -%}
      </video>
    </video-background-component>
  {%- else -%}
    <div class="{{ video_classes }}">
      {%- assign placeholder_name = placeholder | default: 'hero-apparel-2' -%}
      {%- if placeholder_name == blank -%}
        {%- assign placeholder_name = 'hero-apparel-2' -%}
      {%- endif -%}
      {{ placeholder_name | placeholder_svg_tag }}
    </div>
  {%- endif -%}
{% elsif background_media == 'image' %}
  {% liquid
    assign bg_desktop = background_image
    assign bg_mobile = background_image_mobile
    if bg_mobile == blank
      assign bg_mobile = background_image
    endif

    assign has_desktop_image = false
    if bg_desktop != blank
      assign has_desktop_image = true
    endif

    assign has_mobile_image = false
    if bg_mobile != blank
      assign has_mobile_image = true
    endif

    assign use_responsive_images = false
    if has_desktop_image and background_image_mobile != blank and bg_desktop != background_image_mobile
      assign use_responsive_images = true
    endif

    assign mobile_only_image = false
    if has_desktop_image == false and background_image_mobile != blank
      assign mobile_only_image = true
    endif

    if block.settings
      if section.settings.section_width == 'full-width'
        assign sizes = '100vw'
      else
        case settings.page_width
          when 'narrow'
            assign sizes = '(min-width: 1440px) 1440px, 100vw'
          when 'normal'
            assign sizes = '(min-width: 1920px) 1920px, 100vw'
          when 'wide'
            assign sizes = '(min-width: 2400px) 2400px, 100vw'
          else
            assign sizes = '100vw'
        endcase
      endif
    else
      assign sizes = '100vw'
    endif

    assign widths = '832, 1200, 1600, 1920, 2560, 3840'
    assign fetch_priority = 'auto'
    assign loading = 'lazy'
    if section and section.index == 1
      assign fetch_priority = 'high'
    endif
    if section and section.index <= 3
      assign loading = 'eager'
    endif
  %}

  <div
    class="background-image-container{% if background_image_position == 'fit' %} background-image-fit{% endif %}"
  >
    {%- if has_desktop_image or has_mobile_image -%}
      {%- if use_responsive_images -%}
        {{
          bg_desktop
          | image_url: width: 3840
          | image_tag:
            class: 'background-image__img background-image__img--desktop',
            sizes: sizes,
            widths: widths,
            loading: loading,
            fetchpriority: fetch_priority
        }}
        {{
          background_image_mobile
          | image_url: width: 3840
          | image_tag:
            class: 'background-image__img background-image__img--mobile',
            sizes: sizes,
            widths: widths,
            loading: loading,
            fetchpriority: fetch_priority
        }}
      {%- elsif mobile_only_image -%}
        {{
          background_image_mobile
          | image_url: width: 3840
          | image_tag:
            class: 'background-image__img background-image__img--mobile-only',
            sizes: sizes,
            widths: widths,
            loading: loading,
            fetchpriority: fetch_priority
        }}
      {%- elsif has_desktop_image -%}
        {{
          bg_desktop
          | image_url: width: 3840
          | image_tag: sizes: sizes, widths: widths, loading: loading, fetchpriority: fetch_priority
        }}
      {%- endif -%}
    {%- else -%}
      {%- assign placeholder_name = placeholder | default: 'hero-apparel-2' -%}
      {%- if placeholder_name == blank -%}
        {%- assign placeholder_name = 'hero-apparel-2' -%}
      {%- endif -%}
      {{ placeholder_name | placeholder_svg_tag }}
    {%- endif -%}
  </div>
{% endif %}

{% stylesheet %}
  @media screen and (max-width: 749px) {
    .background-image__img--desktop {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .background-image__img--mobile,
    .background-image__img--mobile-only {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    video-background-component video {
      display: none;
    }
  }
{% endstylesheet %}
