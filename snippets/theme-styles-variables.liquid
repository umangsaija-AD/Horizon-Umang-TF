{% comment %} Global fonts load via snippets/fonts.liquid (Google Fonts). @font-face from theme settings is not used. {% endcomment %}
{% style %}
  {%- liquid
    assign button_padding_inline_sm = settings.button_padding_inline_small | append: 'px'
    assign button_padding_block_sm = settings.button_padding_block_small | append: 'px'
    assign button_padding_inline_md = settings.button_padding_inline_medium | append: 'px'
    assign button_padding_block_md = settings.button_padding_block_medium | append: 'px'
    assign button_padding_inline_lg = settings.button_padding_inline_large | append: 'px'
    assign button_padding_block_lg = settings.button_padding_block_large | append: 'px'

    case settings.button_padding_size
      when 'small'
        assign button_padding_inline = button_padding_inline_sm
        assign button_padding_block = button_padding_block_sm
      when 'large'
        assign button_padding_inline = button_padding_inline_lg
        assign button_padding_block = button_padding_block_lg
      else
        assign button_padding_inline = button_padding_inline_md
        assign button_padding_block = button_padding_block_md
    endcase

  -%}

  :root {
    /* Page Layout */
    --sidebar-width: 25rem;
    --narrow-content-width: 36rem;
    --normal-content-width: 42rem;
    --wide-content-width: 46rem;
    --narrow-page-width: 90rem;
    --normal-page-width: 120rem;
    --wide-page-width: 150rem;

    /* Font families */
    --font-family: 'Poppins', sans-serif;
    --font-style: normal;
    --font-weight: 400;

    /* Section Heights */
    --section-height-small: 15rem;
    --section-height-medium: 25rem;
    --section-height-large: 35rem;

    @media screen and (min-width: 40em) {
      --section-height-small: 40svh;
      --section-height-medium: 55svh;
      --section-height-large: 70svh;
    }

    @media screen and (min-width: 60em) {
      --section-height-small: 50svh;
      --section-height-medium: 65svh;
      --section-height-large: 80svh;
    }

    /* Letter spacing */
    --letter-spacing-sm: 0.06em;
    --letter-spacing-md: 0.13em;

    /* Semantic font tokens (loaded via snippets/fonts.liquid → Poppins) */
    --font-body--family: var(--font-family);
    --font-body--style: var(--font-style);
    --font-body--weight: var(--font-weight);
    --font-heading--family: var(--font-family);
    --font-heading--style: var(--font-style);
    --font-heading--weight: var(--font-weight);

    /* Margin sizes */
    --font-heading--spacing: 0.25em;
    --font-h1--spacing: var(--font-heading--spacing);
    --font-h2--spacing: var(--font-heading--spacing);
    --font-h3--spacing: var(--font-heading--spacing);
    --font-h4--spacing: var(--font-heading--spacing);
    --font-h5--spacing: var(--font-heading--spacing);
    --font-h6--spacing: var(--font-heading--spacing);
    --font-paragraph--spacing: 0.5em;

    /* Heading colors */
    --font-h1--color: var(--color-foreground-heading);
    --font-h2--color: var(--color-foreground-heading);
    --font-h3--color: var(--color-foreground-heading);
    --font-h4--color: var(--color-foreground-heading);
    --font-h5--color: var(--color-foreground-heading);
    --font-h6--color: var(--color-foreground-heading);

    /** Z-Index / Layering */
    --layer-section-background: -2;
    --layer-lowest: -1;
    --layer-base: 0;
    --layer-flat: 1;
    --layer-raised: 2;
    --layer-heightened: 4;
    --layer-sticky: 8;
    --layer-window-overlay: 10;
    --layer-header-menu: 12;
    --layer-overlay: 16;
    --layer-menu-drawer: 18;
    --layer-temporary: 20;

    /* Max-width / Measure */
    --max-width--body-normal: 32.5em;
    --max-width--body-narrow: 22.75em;

    --max-width--heading-normal: 32.5em;
    --max-width--heading-narrow: 19.5em;

    --max-width--display-normal: 13em;
    --max-width--display-narrow: 9.75em;
    --max-width--display-tight: 3.25em;

    /* Line height / letter-spacing (Typography.md defaults; no theme settings) */
    --line-height: 1;
    --line-height--font-display: 1.2;

    /* H3–H6: -2% desktop, 0% mobile per Typography.md */
    --letter-spacing--h3: -0.02em;
    --letter-spacing--h4: -0.02em;
    --letter-spacing--h5: -0.02em;
    --letter-spacing--h6: -0.02em;

    @media screen and (max-width: 749px) {
      :root {
        --letter-spacing--h3: 0;
        --letter-spacing--h4: 0;
        --letter-spacing--h5: 0;
        --letter-spacing--h6: 0;
      }
    }

    /* Typography presets */
    {% liquid
      assign font_sizes = "h1, h2, h3, h4, h5, h6" | split: ", "
      for font_size in font_sizes
        assign size_setting = 'type_size_[font_size]' | replace: '[font_size]', font_size
        assign mobile_size_setting = 'type_size_[font_size]_mobile' | replace: '[font_size]', font_size
        assign font_size_value = settings[size_setting] | times: 1
        assign mobile_font_size_value = settings[mobile_size_setting] | default: settings[size_setting] | times: 1

        if font_size_value > mobile_font_size_value
          assign fluid_size_min_rem = mobile_font_size_value | divided_by: 16.0
          assign fluid_size_max_rem = font_size_value | divided_by: 16.0
          assign fluid_size_delta_rem = font_size_value | minus: mobile_font_size_value | divided_by: 16.0

          echo '--font-size--[font_size]: clamp([fluid_size_min_rem]rem, calc([fluid_size_min_rem]rem + [fluid_size_delta_rem] * ((100vw - 23.4375rem) / 66.5625)), [fluid_size_max_rem]rem);' | replace: '[font_size]', font_size | replace: '[fluid_size_min_rem]', fluid_size_min_rem | replace: '[fluid_size_delta_rem]', fluid_size_delta_rem | replace: '[fluid_size_max_rem]', fluid_size_max_rem
        else
          assign font_size_rem = font_size_value | divided_by: 16.0
          echo '--font-size--[font_size]: [font_size_rem]rem;' | replace: '[font_size]', font_size | replace: '[font_size_rem]', font_size_rem
        endif
      endfor

      assign type_presets = "paragraph, h1, h2, h3, h4, h5, h6" | split: ", "

      for preset_name in type_presets
        assign preset_size = '--font-size--[preset_name]' | replace: '[preset_name]', preset_name

        if preset_name == 'paragraph'
          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '400'
          assign preset_case = 'none'
          assign preset_size = '--font-size--md'

          echo '--font-[preset_name]--weight: [preset_weight];' | replace: '[preset_name]', preset_name | replace: '[preset_weight]', preset_weight
          echo '--font-[preset_name]--line-height: 1.4;' | replace: '[preset_name]', preset_name
          echo '--font-[preset_name]--letter-spacing: 0;' | replace: '[preset_name]', preset_name
        else
          assign preset_font = '--font-heading--family'
          assign preset_style = '--font-heading--style'
          assign preset_weight = '--font-heading--weight'
          assign preset_case = 'type_case_[preset_name]' | replace: '[preset_name]', preset_name

          echo '--font-[preset_name]--weight: var([preset_weight]);' | replace: '[preset_name]', preset_name | replace: '[preset_weight]', preset_weight
          echo '--font-[preset_name]--line-height: 1.2;' | replace: '[preset_name]', preset_name
          if preset_name == 'h1' or preset_name == 'h2'
            echo '--font-[preset_name]--letter-spacing: -0.02em;' | replace: '[preset_name]', preset_name
          else
            echo '--font-[preset_name]--letter-spacing: var(--letter-spacing--[preset_name]);' | replace: '[preset_name]', preset_name
          endif
        endif

        echo '--font-[preset_name]--size: var([preset_size]);' | replace: '[preset_name]', preset_name | replace: '[preset_size]', preset_size
        echo '--font-[preset_name]--family: var([preset_font]);' | replace: '[preset_name]', preset_name | replace: '[preset_font]', preset_font
        echo '--font-[preset_name]--style: var([preset_style]);' | replace: '[preset_name]', preset_name | replace: '[preset_style]', preset_style
        if preset_name == 'paragraph'
          echo '--font-[preset_name]--case: [preset_case];' | replace: '[preset_name]', preset_name | replace: '[preset_case]', preset_case
        else
          echo '--font-[preset_name]--case: [preset_case];' | replace: '[preset_name]', preset_name | replace: '[preset_case]', settings[preset_case]
        endif
      endfor

      comment
        Typography presets from design reference:
        display, body-regular, body-small, label, and tag.
      endcomment
      assign display_size_desktop = settings.type_size_display | default: 72 | times: 1
      assign display_size_mobile = settings.type_size_display_mobile | default: 40 | times: 1
      assign display_size_mobile_rem = display_size_mobile | divided_by: 16.0
      assign display_size_desktop_rem = display_size_desktop | divided_by: 16.0
      assign display_size_delta_rem = display_size_desktop | minus: display_size_mobile | divided_by: 16.0
      echo '--font-size--display: clamp([display_size_mobile_rem]rem, calc([display_size_mobile_rem]rem + [display_size_delta_rem] * ((100vw - 23.4375rem) / 66.5625)), [display_size_desktop_rem]rem);' | replace: '[display_size_mobile_rem]', display_size_mobile_rem | replace: '[display_size_delta_rem]', display_size_delta_rem | replace: '[display_size_desktop_rem]', display_size_desktop_rem
      echo '--font-display--size: var(--font-size--display);'
      echo '--font-display--family: var(--font-heading--family);'
      echo '--font-display--style: var(--font-heading--style);'
      echo '--font-display--weight: var(--font-heading--weight);'
      echo '--font-display--line-height: 1.2;'
      echo '--font-display--letter-spacing: -0.02em;'
      echo '--font-display--case: none;'

      assign br_desktop = settings.type_size_body_regular | default: 16 | times: 1
      assign br_mobile = settings.type_size_body_regular_mobile | default: settings.type_size_body_regular | default: 16 | times: 1
      if br_desktop > br_mobile
        assign br_min_rem = br_mobile | divided_by: 16.0
        assign br_max_rem = br_desktop | divided_by: 16.0
        assign br_delta_rem = br_desktop | minus: br_mobile | divided_by: 16.0
        echo '--font-body-regular--size: clamp([br_min_rem]rem, calc([br_min_rem]rem + [br_delta_rem] * ((100vw - 23.4375rem) / 66.5625)), [br_max_rem]rem);' | replace: '[br_min_rem]', br_min_rem | replace: '[br_delta_rem]', br_delta_rem | replace: '[br_max_rem]', br_max_rem
      else
        assign br_rem = br_desktop | divided_by: 16.0
        echo '--font-body-regular--size: [br_rem]rem;' | replace: '[br_rem]', br_rem
      endif
      echo '--font-body-regular--family: var(--font-body--family);'
      echo '--font-body-regular--style: var(--font-body--style);'
      echo '--font-body-regular--weight: var(--font-body--weight);'
      echo '--font-body-regular--line-height: 1.4;'
      echo '--font-body-regular--letter-spacing: 0;'
      echo '--font-body-regular--case: none;'

      assign bs_desktop = settings.type_size_body_small | default: 14 | times: 1
      assign bs_mobile = settings.type_size_body_small_mobile | default: settings.type_size_body_small | default: 14 | times: 1
      if bs_desktop > bs_mobile
        assign bs_min_rem = bs_mobile | divided_by: 16.0
        assign bs_max_rem = bs_desktop | divided_by: 16.0
        assign bs_delta_rem = bs_desktop | minus: bs_mobile | divided_by: 16.0
        echo '--font-body-small--size: clamp([bs_min_rem]rem, calc([bs_min_rem]rem + [bs_delta_rem] * ((100vw - 23.4375rem) / 66.5625)), [bs_max_rem]rem);' | replace: '[bs_min_rem]', bs_min_rem | replace: '[bs_delta_rem]', bs_delta_rem | replace: '[bs_max_rem]', bs_max_rem
      else
        assign bs_rem = bs_desktop | divided_by: 16.0
        echo '--font-body-small--size: [bs_rem]rem;' | replace: '[bs_rem]', bs_rem
      endif
      echo '--font-body-small--family: var(--font-body--family);'
      echo '--font-body-small--style: var(--font-body--style);'
      echo '--font-body-small--weight: var(--font-body--weight);'
      echo '--font-body-small--line-height: 1.4;'
      echo '--font-body-small--letter-spacing: 0;'
      echo '--font-body-small--case: none;'

      assign lb_desktop = settings.type_size_label | default: 12 | times: 1
      assign lb_mobile = settings.type_size_label_mobile | default: settings.type_size_label | default: 12 | times: 1
      if lb_desktop > lb_mobile
        assign lb_min_rem = lb_mobile | divided_by: 16.0
        assign lb_max_rem = lb_desktop | divided_by: 16.0
        assign lb_delta_rem = lb_desktop | minus: lb_mobile | divided_by: 16.0
        echo '--font-label--size: clamp([lb_min_rem]rem, calc([lb_min_rem]rem + [lb_delta_rem] * ((100vw - 23.4375rem) / 66.5625)), [lb_max_rem]rem);' | replace: '[lb_min_rem]', lb_min_rem | replace: '[lb_delta_rem]', lb_delta_rem | replace: '[lb_max_rem]', lb_max_rem
      else
        assign lb_rem = lb_desktop | divided_by: 16.0
        echo '--font-label--size: [lb_rem]rem;' | replace: '[lb_rem]', lb_rem
      endif
      echo '--font-label--family: var(--font-body--family);'
      echo '--font-label--style: var(--font-body--style);'
      echo '--font-label--weight: var(--font-body--weight);'
      echo '--font-label--line-height: 1.4;'
      echo '--font-label--letter-spacing: 0;'
      echo '--font-label--case: none;'

      assign tg_desktop = settings.type_size_tag | default: 12 | times: 1
      assign tg_mobile = settings.type_size_tag_mobile | default: settings.type_size_tag | default: 12 | times: 1
      if tg_desktop > tg_mobile
        assign tg_min_rem = tg_mobile | divided_by: 16.0
        assign tg_max_rem = tg_desktop | divided_by: 16.0
        assign tg_delta_rem = tg_desktop | minus: tg_mobile | divided_by: 16.0
        echo '--font-tag--size: clamp([tg_min_rem]rem, calc([tg_min_rem]rem + [tg_delta_rem] * ((100vw - 23.4375rem) / 66.5625)), [tg_max_rem]rem);' | replace: '[tg_min_rem]', tg_min_rem | replace: '[tg_delta_rem]', tg_delta_rem | replace: '[tg_max_rem]', tg_max_rem
      else
        assign tg_rem = tg_desktop | divided_by: 16.0
        echo '--font-tag--size: [tg_rem]rem;' | replace: '[tg_rem]', tg_rem
      endif
      echo '--font-tag--family: var(--font-body--family);'
      echo '--font-tag--style: var(--font-body--style);'
      echo '--font-tag--weight: var(--font-body--weight);'
      echo '--font-tag--line-height: 1.4;'
      echo '--font-tag--letter-spacing: 0.01em;'
      echo '--font-tag--case: [tag_case];' | replace: '[tag_case]', settings.type_case_tag
    %}

    /* Hardcoded font sizes */
    --font-size--3xs: 0.625rem;
    --font-size--2xs: 0.75rem;
    --font-size--xs: 0.8125rem;
    --font-size--sm: 0.875rem;
    --font-size--md: 1rem;
    --font-size--lg: 1.125rem;
    --font-size--xl: 1.25rem;
    --font-size--2xl: 1.5rem;
    --font-size--3xl: 2rem;
    --font-size--4xl: 2.5rem;
    --font-size--5xl: 3rem;
    --font-size--6xl: 3.5rem;
    --font-size--7xl: 4.5rem;
    --font-size--8xl: 6rem;
    --font-size--9xl: 8rem;

    /* Menu font sizes */
    --menu-font-sm--size: 0.875rem;
    --menu-font-sm--line-height: calc(1.1 + 0.5 * min(16 / 14));
    --menu-font-md--size: 1rem;
    --menu-font-md--line-height: calc(1.1 + 0.5 * min(16 / 16));
    --menu-font-lg--size: 1.125rem;
    --menu-font-lg--line-height: calc(1.1 + 0.5 * min(16 / 18));
    --menu-font-xl--size: 1.25rem;
    --menu-font-xl--line-height: calc(1.1 + 0.5 * min(16 / 20));
    --menu-font-2xl--size: 1.75rem;
    --menu-font-2xl--line-height: calc(1.1 + 0.5 * min(16 / 28));

    /* Colors */
    --color-error: #8B0000;
    --color-success: #006400;
    --color-white: #FFFFFF;
    --color-white-rgb: 255 255 255;
    --color-black: #000000;
    --color-black-secondary: #1D1D1D;
    --color-black-light: #464646;
    --color-gray-light: #EDEDED;
    --color-link: #2563EB;
    --color-instock: #3ED660;
    --color-lowstock: #EE9441;
    --color-outofstock: #C8C8C8;

    /* Opacity */
    --opacity-5: 0.05;
    --opacity-8: 0.08;
    --opacity-10: 0.1;
    --opacity-15: 0.15;
    --opacity-20: 0.2;
    --opacity-25: 0.25;
    --opacity-30: 0.3;
    --opacity-40: 0.4;
    --opacity-50: 0.5;
    --opacity-60: 0.6;
    --opacity-70: 0.7;
    --opacity-80: 0.8;
    --opacity-85: 0.85;
    --opacity-90: 0.9;
    --opacity-subdued-text: var(--opacity-70);

    --shadow-button: 0 2px 3px rgb(0 0 0 / 20%);
    --gradient-image-overlay: linear-gradient(to top, rgb(0 0 0 / 0.5), transparent);

    /* Spacing */
    --margin-3xs: 0.125rem;
    --margin-2xs: 0.3rem;
    --margin-xs: 0.5rem;
    --margin-sm: 0.7rem;
    --margin-md: 0.8rem;
    --margin-lg: 1rem;
    --margin-xl: 1.25rem;
    --margin-2xl: 1.5rem;
    --margin-3xl: 1.75rem;
    --margin-4xl: 2rem;
    --margin-5xl: 3rem;
    --margin-6xl: 5rem;

    --scroll-margin: 50px;

    --padding-3xs: 0.125rem;
    --padding-2xs: 0.25rem;
    --padding-xs: 0.5rem;
    --padding-sm: 0.7rem;
    --padding-md: 0.8rem;
    --padding-lg: 1rem;
    --padding-xl: 1.25rem;
    --padding-2xl: 1.5rem;
    --padding-3xl: 1.75rem;
    --padding-4xl: 2rem;
    --padding-5xl: 3rem;
    --padding-6xl: 4rem;

    --gap-3xs: 0.125rem;
    --gap-2xs: 0.3rem;
    --gap-xs: 0.5rem;
    --gap-sm: 0.7rem;
    --gap-md: 0.9rem;
    --gap-lg: 1rem;
    --gap-xl: 1.25rem;
    --gap-xl-plus: 1.5rem;
    --gap-2xl: 2rem;
    --gap-3xl: 3rem;

    --spacing-scale-sm: 0.6;
    --spacing-scale-md: 0.7;
    --spacing-scale-default: 1.0;

    /* Checkout buttons gap */
    --checkout-button-gap: 10px;

    /* Borders */
    --style-border-width: 1px;
    --style-border-radius-xs: 0.2rem;
    --style-border-radius-sm: 0.6rem;
    --style-border-radius-md: 0.8rem;
    --style-border-radius-50: 50%;
    --style-border-radius-lg: 1rem;
    --style-border-radius-pills: {{ settings.pills_border_radius }}px;
    --style-border-radius-inputs: {{ settings.inputs_border_radius }}px;
    --style-border-radius-buttons-primary: {{ settings.button_border_radius_primary }}px;
    --style-border-radius-buttons-secondary: {{ settings.button_border_radius_secondary }}px;
    --style-border-width-primary: {{ settings.primary_button_border_width }}px;
    --style-border-width-secondary: {{ settings.secondary_button_border_width }}px;
    --style-border-width-inputs: {{ settings.input_border_width }}px;
    --style-border-radius-popover: {{ settings.popover_border_radius }}px;
    --style-border-popover: {{ settings.popover_border_width }}px {{ settings.popover_border }} rgb(var(--color-border-rgb) / {{ settings.popover_border_opacity }}%);
    --style-border-drawer: {{ settings.drawer_border_width }}px {{ settings.drawer_border }} rgb(var(--color-border-rgb) / {{ settings.drawer_border_opacity }}%);
    --style-border-swatch-opacity: {{ settings.variant_swatch_border_opacity }}%;
    --style-border-swatch-width: {{ settings.variant_swatch_border_width }}px;
    --style-border-swatch-style: {{ settings.variant_swatch_border_style }};

    /* Animation */
    --ease-out-cubic: cubic-bezier(0.33, 1, 0.68, 1);
    --ease-out-quad: cubic-bezier(0.32, 0.72, 0, 1);
    --ease-in-out-quad: cubic-bezier(0.455, 0.03, 0.515, 0.955);
    --animation-speed-fast: 0.0625s;
    --animation-speed: 0.125s;
    --animation-speed-slow: 0.2s;
    --animation-speed-medium: 0.15s;
    --animation-easing: ease-in-out;
    --animation-slideshow-easing: cubic-bezier(0.4, 0, 0.2, 1);
    --drawer-animation-speed: 0.2s;
    --animation-values-slow: var(--animation-speed-slow) var(--animation-easing);
    --animation-values: var(--animation-speed) var(--animation-easing);
    --animation-values-fast: var(--animation-speed-fast) var(--animation-easing);
    --animation-values-allow-discrete: var(--animation-speed) var(--animation-easing) allow-discrete;
    --animation-timing-hover: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --animation-timing-active: cubic-bezier(0.5, 0, 0.75, 0);
    --animation-timing-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
    --animation-timing-default: cubic-bezier(0, 0, 0.2, 1);
    --animation-timing-fade-in: cubic-bezier(0.16, 1, 0.3, 1);
    --animation-timing-fade-out: cubic-bezier(0.4, 0, 0.2, 1);
    /* Spring definitions suffixed with perceptual duration (d<ms>) and bounce (b<%>)*/
    --spring-d300-b0-easing: linear(0, 0.0033 0.81%, 0.027 2.42%, 0.0916 4.84%, 0.4745 15.32%, 0.6422 20.97%, 0.7175, 0.7789, 0.8283 30.64%, 0.876, 0.9111 38.71%, 0.941, 0.9611 48.39%, 0.9707, 0.978 54.84%, 0.9885 62.1%, 0.9949 70.97%, 0.9982 82.26%, 0.9997 100%);
    --spring-d300-b0-duration: 0.4980s;
    --spring-d280-b0-easing: linear(0, 0.0044, 0.0164 1.85%, 0.085 4.63%, 0.4571 14.81%, 0.575 18.52%, 0.6505, 0.7148 24.07%, 0.7849, 0.8393, 0.8809 35.18%, 0.9189, 0.9453 44.44%, 0.9662, 0.9793 55.55%, 0.9894 62.95%, 0.995 71.28%, 0.9982 82.39%, 0.9997 99.98%);
    --spring-d280-b0-duration: 0.4648s;
    --spring-d260-b0-easing: linear(0, 0.0058, 0.0216 2.15%, 0.0748 4.29%, 0.4646 15.03%, 0.5673, 0.655, 0.7279, 0.7872, 0.8349, 0.8727 34.36%, 0.9107, 0.9379 42.95%, 0.9609 48.31%, 0.9778 54.76%, 0.9887 62.27%, 0.9948 70.86%, 0.9983 82.67%, 0.9997 99.85%);
    --spring-d260-b0-duration: 0.4316s;
    --spring-d220-b0-easing: linear(
